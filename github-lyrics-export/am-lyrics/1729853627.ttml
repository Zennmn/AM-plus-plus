<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">ずっと真夜中でいいのに。 (永远是深夜有多好｡)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">晚安</text><text for="L2">17 我曾活过 现已死去</text><text for="L3">你好 再见 我们会再见的</text><text for="L4">晚安</text><text for="L5">17 我曾活过 现已死去</text><text for="L6">你好 再见 我们会再见的</text><text for="L7">还是未能叫醒</text><text for="L8">阻挡在前路的boss</text><text for="L9">眺望着逐渐崩塌的摩天楼</text><text for="L10">今天砂砾仍旧沾污着你的脸颊</text><text for="L11">毫不犹豫 啊</text><text for="L12">如果要记录想待在你身边的理由</text><text for="L13">我会给它取一个方便好听的名字</text><text for="L14">并不从属世俗</text><text for="L15">因为没有前提</text><text for="L16">也不需合眼</text><text for="L17">往嘴里塞进还未成熟的种子</text><text for="L18">直到夕阳西下 我明白了</text><text for="L19">永远并不存在</text><text for="L20">若是连水的触感 连这份温热</text><text for="L21">都感受不到</text><text for="L22">那么便竭尽全力用声音呐喊出来吧</text><text for="L23">所有无法相通的记忆</text><text for="L24">都会冷冻保存下来</text><text for="L25">我拥有的只有这份感情和名字</text><text for="L26">那么每一次握手</text><text for="L27">都是因为程序吗?</text><text for="L28">我才不需要这种</text><text for="L29">不适用于所有人的标准</text><text for="L30">只是虚幻漂浮的</text><text for="L31">那泡沫 也拥有名字</text><text for="L32">在这个世界上</text><text for="L33">难以再现的表情是有意义的</text><text for="L34">连说话都不需要</text><text for="L35">如果由生至死这一世</text><text for="L36">只有一次机会成为人类</text><text for="L37">我会无数次破坏又重组</text><text for="L38">只为了确认这是否是奇迹</text><text for="L39">我们潜入桃子味的汽水中</text><text for="L40">这种情况下稍流几滴眼泪也不会被发现</text><text for="L41">于是我们相互隐瞒着</text><text for="L42">若是这阵颤抖 这份沉重</text><text for="L43">都无法传达</text><text for="L44">那便按下按钮 把一切都消除吧</text><text for="L45">所有不配套的记忆</text><text for="L46">即便做了解答 也只会增加不安</text><text for="L47">我拥有的只有那份感情和名字</text><text for="L48">若是移开目光</text><text for="L49">我便会生锈吧</text><text for="L50">无法隐藏的思考回路</text><text for="L51">化作伤口 我多想触碰你</text><text for="L52">我能说出来吗</text><text for="L53">我不需要任何可以轻易断言的东西</text><text for="L54">就连虚假之物和那见解</text><text for="L55">都不是别人可以决定的</text><text for="L56">是胜是负 是白是黑 是人类</text><text for="L57">还是非人类</text><text for="L58">都已不分对错</text><text for="L59">抱住脆弱的伤口 闭上眼睛吧</text><text for="L60">为了结束今天</text><text for="L61">若是连水的触感 连这份温热</text><text for="L62">都感受不到</text><text for="L63">那么便竭尽全力用声音呐喊出来吧</text><text for="L64">所有无法相通的记忆</text><text for="L65">都会冷冻保存下来</text><text for="L66">我拥有的只有这份感情和名字</text><text for="L67">那么每一次握手</text><text for="L68">都是因为程序吗?</text><text for="L69">我才不需要这种</text><text for="L70">不适用于所有人的标准</text><text for="L71">晚安</text><text for="L72">17 我曾活过 现已死去</text><text for="L73">你好 再见 我们会再见的</text><text for="L74">晚安</text><text for="L75">17 我曾活过 现已死去</text><text for="L76">你好 再见 你好</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Intro"><p begin="0:01.214" end="0:02.476" itunes:key="L1" ttm:agent="v1"><span begin="0:01.214" end="0:01.386">レ</span><span begin="0:01.386" end="0:01.558">イ</span><span begin="0:01.558" end="0:01.886">ラ</span><span begin="0:01.886" end="0:02.069">サ</span><span begin="0:02.069" end="0:02.277">イ</span><span begin="0:02.277" end="0:02.476">ダ</span></p><p begin="0:02.476" end="0:03.784" itunes:key="L2" ttm:agent="v1"><span begin="0:02.476" end="0:02.716">サ</span><span begin="0:02.716" end="0:02.800">ブ</span><span begin="0:02.800" end="0:02.964">ア</span><span begin="0:02.964" end="0:03.128">ッ</span><span begin="0:03.129" end="0:03.269">タ</span><span begin="0:03.269" end="0:03.409">ッ</span><span begin="0:03.409" end="0:03.496">シ</span><span begin="0:03.497" end="0:03.584">ャ</span><span begin="0:03.584" end="0:03.784">ル</span></p><p begin="0:03.957" end