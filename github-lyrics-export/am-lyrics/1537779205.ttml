<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい (当山真玲)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Mirei Touyama</songwriter><songwriter>SoichiroK</songwriter><songwriter>TomoLow</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">呵出的白气 红砖铺砌的道路</text><text for="L2">隔着围巾看见的侧脸</text><text for="L3">冻僵的指尖 开始飘落的雪花</text><text for="L4">这些都是和你依偎在一起的理由</text><text for="L5">街道亮起熠熠灯光的季节</text><text for="L6">想相信你就是我的命运之人</text><text for="L7">而你心里的那个人又是谁呢</text><text for="L8">求求你 求求你 到我的身边来吧</text><text for="L9">握住我的手 紧紧地拥我入怀</text><text for="L10">希望你能明白我难以言喻的心声</text><text for="L11">在这冰冷的 冰冷的 白雪之下</text><text for="L12">置身在这封闭的二人世界之中</text><text for="L13">希望我对你的爱永远不会消失</text><text for="L14">每一次都只有大衣的袖口相触</text><text for="L15">手还是牵不到一起 令我着急不已</text><text for="L16">我竭力克制着每一次四目相合</text><text for="L17">都不禁怦然跳动的心脏</text><text for="L18">雪花翩翩落下 瞬间便融化不见</text><text for="L19">无论幸福还是后悔</text><text for="L20">我都想永远和你一起感受</text><text for="L21">全部 全部 只要和你在一起</text><text for="L22">整座城市都是熠熠璀璨的礼物</text><text for="L23">还不够 还不足够</text><text for="L24">只有一句感谢远不足够</text><text for="L25">就算这冰冷的 冰冷的雪花</text><text for="L26">总有融化的一天</text><text for="L27">也请你不要离我而去</text><text for="L28">每一次相见 我都更想了解你</text><text for="L29">越是了解 就越是喜欢你</text><text for="L30">越是喜欢 就不禁任性地渴求更多</text><text for="L31">回握住你的手的那一刻</text><text for="L32">不经意间对上你的视线</text><text for="L33">心痛的感觉久久不曾消失 已经回不去了</text><text for="L34">你已占据我全部的思考</text><text for="L35">求求你 求求你 到我的身边来吧</text><text for="L36">握住我的手 紧紧地拥我入怀</text><text for="L37">希望你能知晓我说不出口的爱</text><text for="L38">这冰冷的 冰冷的雪花</text><text for="L39">逐渐覆盖了你我二人的世界</text><text for="L40">希望对你的爱永远不要融化</text><text for="L41">永远不要消失</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:17.529" end="0:20.932" itunes:key="L1" ttm:agent="v1"><span begin="0:17.529" end="0:17.977">白</span><span begin="0:17.977" end="0:18.264">い</span><span begin="0:18.264" end="0:18.488">吐</span><span begin="0:18.488" end="0:19.240">息</span> <span begin="0:19.240" end="0:19.544">赤</span><span begin="0:19.544" end="0:19.768">い</span><span begin="0:19.768" end="0:20.234">煉</span><span begin="0:20.234" end="0:20.440">瓦</span><span begin="0:20.440" end="0:20.932">道</span></p><p begin="0:21.206" end="0:24.831" itunes:key="L2" ttm:agent="v1"><span begin="0:21.206" end="0:21.428">マ</span><span begin="0:21.428" end="0:21.652">フ</span><span begin="0:21.652" end="0:21.764">ラ</span><span begin="0:21.764" end="0:22.163">ー</span><span begin="0:22.163" end="0:22.374">越</span><span begin="0:22.374" end="0:22.595">し</span><span begin="0:22.595" end="0:22.894">の</span><span begin="0:22.894" end="0:23.790">横</span><span begin="0:23.790" end="0:24.831">顔</span></p><p begin="0:25.105" end="0:28.700" itunes:key="L3" ttm:agent="v1"><span begin="0:25.105" end="0:25.262">か</span><span begin="0:25.262" end="0:25.486">じ</span><span begin="0:25.486" end="0:25.742">か</span><span begin="0:25.742" end="0:25.998">む</span><span begin="0:25.998" end="0:26.446">指</span><span begin="0:26.446" end="0:26.958">も</span> <span begin="0:26.958" end="0:27.153">降</span><span begin="0:27.153" end="0:27.312">り</span><span begin="0:27.312" end="0:27.534">出</span><span begin="0:27.534" end="0:27.743">し</span><span begin="0:27.743" end="0:27.953">た</span><span begin="0:27.953" end="0:28.430">雪</span><span begin="0:28.430" end="0:28.700">も</span></p><p begin="0:28.972" end="0:31.802" itunes:key="L4" ttm:agent="v1"><span begin="0:28.972" end="0:29.196">寄</span><span begin="0:29.196" end="0:29.436">り</span><span begin="0:29.436" end="0:29.756">添</span><span begin="0:29.757" end="0:30.009">う</span><span begin="0:30.009" end="0:30.218">理</span><span begin="0:30.218" end="0:31.802">由</span></p><p begin="0:32.567" end="0:39.569" itunes:key="L5" ttm:agent="v1"><span begin="0:32.567" end="0:33.239">街</span><span begin="0:33.239" end="0:34.392">が</span> <span begin="0:34.392" end="0:34.568">キ</span><span begin="0:34.568" end="0:34.921">ラ</span><span begin="0:34.921" end="0:35.239">キ</span><span begin="0:35.239" end="0:36.408">ラ</span> <span begin="0:36.408" end="0:36.943">灯</span><span begin="0:36.944" end="0:37.537">っ</span><span begin="0:37.537" end="0:37.697">て</span><span begin="0:37.698" end="0:37.858">い</span><span begin="0:37.858" end="0:38.521">く</span> <span begin="0:38.521" end="0:38.818">季</span><span begin="0:38.818" end="0:39.569">節</span></p><p begin="0:40.388" end="0:43.680" itunes:key="L6" ttm:agent="v1"><span begin="0:40.388" end="0:41.073">運</span><span begin="0:41.073" end="0:41.659">命</span> <span begin="0:41.953" end="0:42.161">だ</span><span begin="0:42.161" end="0:42.291">と</span><span begin="0:42.291" end="0:42.627">信</span><span begin="0:42.627" end="0:42.914">じ</span><span begin="0:42.914" end="0:43.074">た</span><span begin="0:43.074" end="0:43.680">い</span></p><p begin="0:44.146" end="0:51.236" itunes:key="L7" ttm:agent="v1"><span begin="0:44.146" end="0:44.688">君</span> <span begin="0:44.688" end="0:45.105">は</span><span begin="0:45.105" end="0:45.632">誰</span><span begin="0:45.632" end="0:46.033">の</span><span begin="0:46.033" end="0:46.272">こ</span><span begin="0:46.272" end="0:47.584">と</span> <span begin="0:47.584" end="0:47.976">思</span><span begin="0:47.976" end="0:48.149">う</span><span begin="0:48.149" end="0:50.005">の</span><span begin="0:50.004" end="0:51.236">?</span></p></div><div itunes:song-part="PreChorus"><p begin="0:51.940" end="0:55.727" itunes:key="L8" ttm:agent="v1"><span begin="0:51.940" end="0:52.132">お</span><span begin="0:52.132" end="0:52.596">願</span><span begin="0:52.596" end="0:52.887">い</span> <span begin="0:52.887" end="0:53.124">お</span><span begin="0:53.124" end="0:53.542">願</span><span begin="0:53.542" end="0:53.846">い</span> <span begin="0:53.846" end="0:54.084">そ</span><span begin="0:54.084" end="0:54.433">ば</span><span begin="0:54.433" end="0:54.769">に</span><span begin="0:54.769" end="0:55.057">来</span><span begin="0:55.057" end="0:55.727">て</span></p><p begin="0:56.091" end="0:59.610" itunes:key="L9" ttm:agent="v1"><span begin="0:56.091" end="0:56.282">手</span><span begin="0:56.282" end="0:56.522">を</span><span begin="0:56.522" end="0:56.994">握</span><span begin="0:56.994" end="0:57.242">っ</span><span begin="0:57.242" end="0:58.011">て</span> <span begin="0:58.011" end="0:58.202">抱</span><span begin="0:58.202" end="0:58.444">き</span><span begin="0:58.444" end="0:58.698">し</span><span begin="0:58.698" end="0:59.099">め</span><span begin="0:59.099" end="0:59.610">て</span></p><p begin="0:59.836" end="1:06.898" itunes:key="L10" ttm:agent="v1"><span begin="0:59.836" end="1:00.010">言</span><span begin="1:00.010" end="1:00.234">え</span><span begin="1:00.234" end="1:00.396">な</span><span begin="1:00.396" end="1:00.730">い</span> <span begin="1:00.730" end="1:00.938">言</span><span begin="1:00.938" end="1:01.234">え</span><span begin="1:01.234" end="1:01.393">な</span><span begin="1:01.393" end="1:01.985">い</span> <span begin="1:01.985" end="1:02.481">想</span><span begin="1:02.481" end="1:02.689">い</span><span begin="1:02.689" end="1:03.329">伝</span><span begin="1:03.329" end="1:03.553">え</span><span begin="1:03.553" end="1:06.898">て</span></p></div><div itunes:song-part="Chorus"><p begin="1:07.490" end="1:11.183" itunes:key="L11" ttm:agent="v1"><span begin="1:07.490" end="1:08.049">冷</span><span begin="1:08.049" end="1:08.198">た</span><span begin="1:08.198" end="1:08.497">い</span> <span begin="1:08.497" end="1:09.009">冷</span><span begin="1:09.009" end="1:09.153">た</span><span begin="1:09.153" end="1:09.