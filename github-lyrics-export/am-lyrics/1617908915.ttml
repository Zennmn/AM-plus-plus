<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Imagine Dragons</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">有时 我会有些</text><text for="L2">我会有些孤独</text><text for="L3">有时 我会有些</text><text for="L4">我会有些寂寞</text><text for="L5">有些夜晚 我心头泛起孤独</text><text for="L6">即使我身边人头攒动</text><text for="L7">有时我会有些许焦虑</text><text for="L8">因为这些药片并不像医生说的那样奏效</text><text for="L9">我开始头晕目眩 坐立不安</text><text for="L10">如处边缘 岌岌可危 注入药剂</text><text for="L11">长眠不起 年日混淆</text><text for="L12">视听混杂 再三确认</text><text for="L13">试着深吸一口气 开始捕捉画面</text><text for="L14">灯光与相机 动作和场景</text><text for="L15">我的人生故事如此被捕捉</text><text for="L16">哦 亲爱的（有时 我会有点）</text><text for="L17">请为我（我会有点孤独）</text><text for="L18">洒下怜悯（有时 我会有点）</text><text for="L19">陪伴着我（我会有点寂寞）</text><text for="L20">哦 亲爱的（有时 我会有点）</text><text for="L21">请为我（我会有点孤独）</text><text for="L22">洒下怜悯（有时 我会有点）</text><text for="L23">陪伴着我（我会有点寂寞）</text><text for="L24">我说——</text><text for="L25">有时我会微笑 以保持轻松</text><text for="L26">我躲在角落里 希望没人看到我</text><text for="L27">所以我在扮演着 乘着孤舟 困在洞穴的角色</text><text for="L28">鞠一躬 神色骄傲</text><text for="L29">现在看着我 谈论嘴里的各色药丸</text><text for="L30">就在舌下 难道不有趣吗</text><text for="L31">试着深吸一口气 开始捕捉画面</text><text for="L32">灯光与相机 动作和场景</text><text for="L33">我的人生故事就这样被捕捉</text><text for="L34">哦 亲爱的（有时 我会有点）</text><text for="L35">请为我（我会有点孤独）</text><text for="L36">洒下怜悯（有时 我会有点）</text><text for="L37">陪伴着我（我会有点寂寞）</text><text for="L38">哦 亲爱的（有时 我会有点）</text><text for="L39">请为我（我会有点孤独）</text><text for="L40">洒下怜悯（有时 我会有点）</text><text for="L41">陪伴着我（我会有点寂寞）</text><text for="L42">我说，“哦，亲爱的”</text><text for="L43">请为我洒下怜悯</text><text for="L44">哦 亲爱的 你能否为我洒下怜悯</text><text for="L45">你能否陪伴在我身边（陪伴着我，我说，帮帮——）</text><text for="L46">子瓜犭虫 为何我如此孤独</text><text for="L47">哦 亲爱的（有时 我会有点）</text><text for="L48">请为我（我会有点寂寞）</text><text for="L49">洒下怜悯（有时 我会有点）</text><text for="L50">陪伴着我（我会有点孤独）</text><text for="L51">我说 哦 亲爱的（有时 我会有点）</text><text for="L52">请为我（我会有点寂寞）</text><text for="L53">洒下怜悯（有时 我会有点）</text><text for="L54">陪伴着我（我会有点孤独）</text><text for="L55">我说 哦——</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:00.390" end="0:02.760" itunes:key="L1" ttm:agent="v1"><span begin="0:00.390" end="0:01.830">Sometimes</span><span begin="0:01.830" end="0:01.830">,</span> <span begin="0:01.830" end="0:01.980">I</span> <span begin="0:01.980" end="0:02.070">can</span> <span begin="0:02.070" end="0:02.340">get</span> <span begin="0:02.340" end="0:02.370">a</span> <span begin="0:02.370" end="0:02.760">little</span></p><p begin="0:02.940" end="0:05.250" itunes:key="L2" ttm:agent="v1"><span begin="0:02.940" end="0:03.325">I</span> <span begin="0:03.325" end="0:03.710">can</span> <span begin="0:03.710" end="0:04.095">get</span> <span begin="0:04.095" end="0:04.480">a</span> <span begin="0:04.480" end="0:04.865">little</span> <span begin="0:04.865" end="0:05.250">lonely</span></p><p begin="0:05.280" end="0:07.680" itunes:key="L3" ttm:agent="v1"><span begin="0:05.280" end="0:06.720">Sometimes</span><span begin="0:06.720" end="0:06.720">,</span> <span begin="0:06.720" end="0:06.840">I</span> <span begin="0:06.840" end="0:06.930">can</span> <span begin="0:06.930" end="0:07.230">get</span> <span begin="0:07.230" end="0:07.260">a</span> <span begin="0:07.260" end="0:07.680">little</span></p><p begin="0:07.860" end="0:09.630" itunes:key="L4" ttm:agent="v1"><span begin="0:07.860" end="0:08.070">I</span> <span begin="0:08.070" end="0:08.190">can</span> <span begin="0:08.190" end="0:08.460">get</span> <span begin="0:08.460" end="0