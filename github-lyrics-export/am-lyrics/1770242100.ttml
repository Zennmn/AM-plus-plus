<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">ずっと真夜中でいいのに。 (永远是深夜有多好｡)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">并非谎言</text><text for="L2">啊啊 初次见面的那首曲子</text><text for="L3">此刻我仍会时不时忆起</text><text for="L4">任性的暗号 “ ”</text><text for="L5">我会习惯性地将其哼唱</text><text for="L6">偷懒休息沉溺幻想</text><text for="L7">身体动弹不得 在不上学的日常</text><text for="L8">沉浸其中的刹那</text><text for="L9">有着不可比拟的价值</text><text for="L10">你在沉睡的时候 我则清醒异常</text><text for="L11">因想与你见面而历经磨合</text><text for="L12">别再将难以遮掩的习惯</text><text for="L13">一个接一个细数了</text><text for="L14">将我的裂痕与你的日常</text><text for="L15">就此编织的发明</text><text for="L16">在一切中断之前一定能传达</text><text for="L17">现在有时间吗？ 没有吗</text><text for="L18">遗憾错失 初次见面的那首曲子</text><text for="L19">此刻我仍会时不时忆起</text><text for="L20">任性的暗号 “ ”</text><text for="L21">我总挂在嘴边哼唱 这种话已不再是谎言</text><text for="L22">绝非谎言</text><text for="L23">这并非转瞬即逝的光辉</text><text for="L24">幻觉不过简单的表现</text><text for="L25">任性的暗号</text><text for="L26">请不要将那句“再见”说出口来</text><text for="L27">不需要放在心上 却再次吐槽抱怨</text><text for="L28">甚至无法敷衍着将其带过</text><text for="L29">一切取决于你 让人徒增无趣的期待</text><text for="L30">我也只能说出这种话而已</text><text for="L31">消失的瞬间才确实无疑</text><text for="L32">是觉得愉悦？还是无关紧要？</text><text for="L33">若是最后毫无责任可言</text><text for="L34">那就与刚刚煮好的米饭无异</text><text for="L35">与我而言其实是相当奢侈的事情</text><text for="L36">模棱两可的时代 只为一切都能安然无恙</text><text for="L37">会不惜性命发出诅咒</text><text for="L38">尽快实现下个目标</text><text for="L39">如果觉得一切要由自己选择那便仍有胜算</text><text for="L40">遗憾错失 在离别之时意犹未尽的歌曲</text><text for="L41">此刻我仍会时不时忆起</text><text for="L42">任性的暗号 “ ”</text><text for="L43">我总挂在嘴边哼唱 这种话已不再是谎言</text><text for="L44">绝非谎言</text><text for="L45">这并非转瞬即逝的光辉</text><text for="L46">实在是太过重要且让人盲目 胆怯的风</text><text for="L47">如此柔和不免让人意志消沉</text><text for="L48">批量生产=敌对</text><text for="L49">就算感到担心我仍会谢绝帮忙</text><text for="L50">私下练习 不会有问题</text><text for="L51">毕竟一切还不曾开始</text><text for="L52">堂堂正正 撤回前言</text><text for="L53">偏见惹人厌恶 那便等同于邪恶</text><text for="L54">将其体现出来 再尽数将其破坏</text><text for="L55">我都知道 心知肚明</text><text for="L56">双手冰凉</text><text for="L57">只是避开就已竭尽了全力</text><text for="L58">虚无的理想也是理想</text><text for="L59">我已经不愿再一味地妥协了</text><text for="L60">遗憾错失 初次见面的那首曲子</text><text for="L61">此刻我仍会时不时忆起</text><text for="L62">任性的暗号 “ ”</text><text for="L63">我总挂在嘴边哼唱 这种话已不再是谎言</text><text for="L64">绝非谎言</text><text for="L65">这并非转瞬即逝的光辉</text><text for="L66">幻觉不过简单的表现</text><text for="L67">任性的暗号</text><text for="L68">请不要将那句“再见”说出口来</text><text for="L69">不需要放在心上 却再次吐槽抱怨</text><text for="L70">甚至无法敷衍着将其带过</text><text for="L71">若是没有你在 未来终究是百无聊赖</text><text for="L72">我也只能说出这种话而已</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Intro"><p begin="0:01.299" end="0:02.340" itunes:key="L1" ttm:agent="v1"><span begin="0:01.299" end="0:01.748">嘘</span><span begin="0:01.748" end="0:01.852">じ</span><span begin="0:01.852" end="0:01.956">ゃ</span><span begin="0:01.956" end="0:02.083">な</span><span begin="0:02.083" end="0:02.340">い</span></p></div><div itunes:song-part="Verse"><p begin="0:02.340" end="0:05.587" itunes:key="L2" ttm:agent="v1"><span begin="0:02.340" end="0:02.508">嗚</span><span begin="0:02.508" end="0:02.668">呼</span> <span begin="0:02.828" end="0:03.547">初</span><span begin="0:03.547" end="0:03.832">め</span><span begin="0:03.832" end="0:04.032">ま</span><span begin="0:04.032" end="0:04.256">し</span><span begin="0:04.256" end="0:04.384">て</span><span begin="0:04.384" end="0:04.672">の</span><span begin="0:04.672" end="0:05.104">曲</span><span begin="0:05.104" end="0:05.587">を</span></p><p begin="0:05.587" end="0:09.172" itunes:key="L3" ttm:agent="v1"><span begin="0:05.587" end="0:06.011">今</span><span begin="0:06.011" end="0:06.155">も</span><span begin="0:06.155" end="0:06.427">ま</span><span begin="0:06.427" end="0:06.827">だ</span><span begin="0:06.827" end="0:07.475">思</span><span begin="0:07.475" end="0:07.707">い</span><span begin="0:07.707" end="0:08.204">返</span><span begin="0:08.204" end="0:08.356">し</span><span begin="0:08.356" end="0:08.628">ま</span><span begin="0:08.628" end="0:09.172">す</span></p><p begin="0:09.172" end="0:11.964" itunes:key="L4" ttm:agent="v1"><span begin="0:09.172" end="0:09.860">我</span><span begin="0:09.860" end="0:10.316">侭</span><span begin="0:10.316" end="0:10.756">な</span><span begin="0:10.756" end="0:11.124">合</span><span begin="0:11.124" end="0:11.444">言</span><span begin="0:11.444" end="0:11.704">葉</span> <span begin="0:11.704" end="0:11.964">“ ”</span></p><p begin="0:11.964" end="0:17.191" itunes:key="L5" ttm:agent="v1"><span begin="0:11.964" end="0:12.332">口</span><span begin="0:12.332" end="0:12.580">ず</span><span begin="0:12.580" end="0:12.924">さ</span><span begin="0:12.924" end="0:13.084">む</span><span begin="0:13.084" end="0:13.380">習</span><span begin="0:13.380" end="0:13.748">慣</span><span begin="0:13.748" end="0:14.164">な</span><span begin="0:14.164" end="0:14.580">ん</span><span begin="0:14.580" end="0:16.679">で</span><span begin="0:16.679" end="0:17.191">す</span></p><p begin="0:29.867" end="0:31.597" itunes:key="L6" ttm:agent="v1"><span begin="0:29.867" end="0:30.219">空</span><span begin="0:30.219" end="0:30.539">想</span><span begin="0:30.539" end="0:30.683">の</span><span begin="0:30.683" end="0:30.883">ず</span><span begin="0:30.883" end="0:30.987">る</span><span begin="0:30.987" end="0:31.259">休</span><span begin="0:31.259" end="0:31.597">み</span></p><p begin="0:31.597" end="0:34.837" itunes:key="L7" ttm:agent="v1"><span begin="0:31.597" end="0:31.765">身</span><span begin="0:31.765" end="0:32.053">動</span><span begin="0:32.053" end="0:32.253">き</span><span begin="0:32.253" end="0:32.469">と</span><span begin="0:32.469" end="0:32.645">れ</span><span begin="0:32.645" end="0:32.781">な</span><span begin="0:32.781" end="0:32.965">い</span> <span begin="0:32.965" end="0:33.093">不</span><span begin="0:33.093" end="0:33.405">登</span><span begin="0:33.405" end="0:33.701">校</span><span begin="0:33.701" end="0:33.837">な</span><span begin="0:33.837" end="0:34.277">日</span><span begin="0:34.277" end="0:34.405">常</span><span begin="0:34.405" end="0:34.837">は</span></p><p begin="0:34.837" end="0:36.195" itunes:key="L8" ttm:agent="v1"><span begin="0:34.837" end="0:35.189">比</span><span begin="0:35.189" end="0:35.357">べ</span><span begin="0:35.357" end="0:35.424">よ</span><span begin="0:35.424" end="0:35.491">う</span><span begin="0:35.492" end="0:35.701">も</span><span begin="0:35.701" end="0:35.973">な</span><span begin="0:35.973" end="0:36.195">く</span></p><p begin="0:36.195" end="0:41.780" itunes:key="L9" ttm:agent="v1"><span begin="0:36.195" end="0:37.683">浸</span><span begin="0:37.683" end="0:38.451">る</span><span begin="0:38.451" end="0:38.819">刹</span><span begin="0:38.819" end="0:39.091">那</span><span begin="0:39.091" end="0:39.307">に</span><span begin="0:39.307" end="0:39.531">価</span><span begin="0:39.531" end="0:40.219">値</span><span begin="0:40.219" end="0:40.875">あ</span><span begin="0:40.875" end="0:41.780">り</span></p><p begin="0:42.600" end="0:45.892" itunes:key="L10" ttm:agent="v1"><span begin="0:42.600" end="0:43.352">君</span><span begin="0:43.352" end="0:43.472">が</span><span begin="0:43.472" end="0:43.536">寝</span><span begin="0:43.536" end="0:43.664">て</span><span begin="0:43.664" end="0:43.792">る</span><span begin="0:43.792" end="0:43.872">時</span><span begin="0:43.872" end="0:44.213">間</span> <span begin="0:44.384" end="0:44.739">私</span><span begin="0:44.739" end="0:44.955">は</span><span begin="0:44.955" end="0:45.219">冴</span><span begin="0:45.219" end="0:45.467">え</span><span begin="0:45.467" end="0:45.651">て</span><span begin="0:45.651" end="0:45.892">る</span></p><p begin="0:45.892" end="0:47.574" itunes:key="L11" ttm:agent="v1"><span begin="0:45.892" end="0:46.092">会</span><span begin="0:46.092" end="0:46.244">い</span><span begin="0:46.244" end="0:46.428">た</span><span begin="0:46.428" end="0:46.588">い</span><span begin="0:46.588" end="0:46.676">の</span><span begin="0:46.676" end="0:46.780">擦</span><span begin="0:46.780" end="0:46.900">り</span><span begin="0:46.900" end="0:47.036">合</span><span begin="0:47.036" end="0:47.132">わ</span><span begin="0:47.132" end="0:47.574">せ</span></p><p begin="0:47.574" end="0:51.263" itunes:key="L12" ttm:agent="v1"><span begin="0:47.574" end="0:47.830">被</span><span begin="0:47.830" end="0:47.998">ら</span><span begin="0:47.998" end="0:48.230">な</span><span begin="0:48.230" end="0:48.462">い</span><span begin="0:48.462" end="0:48.686">習</span><span begin="0:48.686" end="0:49.070">慣</span><span begin="0:49.070" end="0:49.862">ば</span><span begin="0:49.862" end="0:50.518">か</span><span begin="0:50.518" end="0:51.263">り</span></p><p begin="0:51.263" end="0:55.064" itunes:key="L13" ttm:agent="v1"><span begin="0:51.263" end="0:51.623">数</span><span begin="0:51.623" end="0:51.855">え</span><span begin="0:51.855" end="0:52.071">る</span><span begin="0:52.071" end="0:52.295">の</span><span begin="0:52.295" end="0:53.063">や</span><span begin="0:53.063" end="0:53.687">め</span><span begin="0:53.687" end="0:55.064">よ</span></p><p begin="0:55.662" end="0:58.918" itunes:key="L14" ttm:agent="v1"><span begin="0:55.662" end="0:56.318">私</span><span begin="0:56.318" end="0:56.526">の</span><span begin="0:56.526" end="0:56.711">ヒ</span><span begin="0:56.711" end="0:57.094">ビ</span><span begin="0:57.094" end="0:57.342">と</span><span begin="0:57.342" end="0:57.974">君</span><span begin="0:57.974" end="0:58.166">の</span><span begin="0:58.166" end="0:58.350">日</span><span begin="0:58.350" end="0:58.662">々</span><span begin="0:58.662" end="0:58.918">を</span></p><p begin="0:58.918" end="1:02.078" itunes:key="L15" ttm:agent="v1"><span begin="0:58.918" end="0:59.262">紡</span><span begin="0:59.262" end="0:59.430">い</span><span begin="0:59.430" end="0:59.670">で</span><span begin="0:59.670" end="1:00.006">ゆ</span><span begin="1:00.006" end="1:00.470">く</span><span begin="1:00.470" end="1:01.062">発</span><span begin="1:01.062" end="1:02.078">明</span></p><p begin="1:02.078" end="1:05.400" itunes:key="L16" ttm:agent="v1"><span begin="1:02.078" end="1:02.278">途</span><span begin="1:02.278" end="1:02.454">切</span><span begin="1:02.454" end="1:02.663">れ</span><span begin="1:02.663" end="1:03.054">て</span><span begin="1:03.054" end="1:03.238">く</span><span begin="1:03.238" end="1:03.583">前</span><span begin="1:03.583" end="1:03.790">に</span><span begin="1:03.790" end="1:04.390">伝</span><span begin="1:04.390" end="1:04.583">え</span><span begin="1:04.583" end="1:04.766">ら</span><span begin="1:04.766" end="1:04.998">れ</span><span begin="1:04.998" end="1:05.400">る</span></p><p begin="1:05.400" end="1:10.153" itunes:key="L17" ttm:agent="v1"><span begin="1:05.400" end="1:05.800">今</span><span begin="1:05.800" end="1:05.960">時</span><span begin="1:05.960" end="1:06.312">間</span><span begin="1:06.312" end="1:06.512">あ</span><span begin="1:06.512" end="1:07.336">る</span><span begin="1:07.336" end="1:08.080">？</span> <span begin="1:08.080" end="1:08.560">な</span><span begin="1:08.560" end="1:08.880">い</span><span begin="1:08.880" end="1:09.432">か</span><span begin="1:09.432" end="1:10.153">な</span></p></div><div itunes:song-part="PreChorus"><p begin="1:10.896" end="1:14.820" itunes:key="L18" ttm:agent="v1"><span begin="1:10.896" end="1:11.072">す</span><span begin="1:11.072" end="1:11.249">れ</span><span begin="1:11.249" end="1:11.668">違</span><span begin="1:11.668" end="1:11.864">っ</span><span begin="1:11.864" end="1:12.268">た</span><span begin="1:12.268" end="1:12.876">初</span><span begin="1:12.87