<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">八神純子 (Junko Yagami)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>三浦徳子</songwriter><songwriter>八神純子</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">啊 湛蓝清透的雨滴</text><text for="L2">小心翼翼地环抱着我的双肩</text><text for="L3">不绝挥洒</text><text for="L4">啊 就此零落崩溃</text><text for="L5">连痕迹都无法被找见 流逝无踪的</text><text for="L6">爱的形态</text><text for="L7">你真是个</text><text for="L8">温柔的人啊</text><text for="L9">对你佯装不见</text><text for="L10">是我犯下的过错</text><text for="L11">直到一时的兴起</text><text for="L12">从我心中消散时</text><text for="L13">我依然忘怀 早已忘怀</text><text for="L14">爱过你的曾经</text><text for="L15">啊 湛蓝清透的雨滴</text><text for="L16">小心翼翼地环抱着我的双肩</text><text for="L17">不绝挥洒</text><text for="L18">啊 就此忘怀吧</text><text for="L19">连痕迹都无法被找见 流逝无踪的</text><text for="L20">爱的形态</text><text for="L21">你责怪的话语</text><text for="L22">我都一一认真听着</text><text for="L23">在那微笑不断</text><text for="L24">怀念的时光中</text><text for="L25">伤的有多深</text><text for="L26">眼神便有多寂寞</text><text for="L27">已无法重回 无法回到</text><text for="L28">那天的我们</text><text for="L29">啊 湛蓝清透的雨滴</text><text for="L30">小心翼翼地环抱着我的双肩</text><text for="L31">不绝挥洒</text><text for="L32">啊 就此零落崩溃</text><text for="L33">连痕迹都无法被找见 流逝无踪的</text><text for="L34">爱的形态</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Chorus"><p begin="0:14.577" end="0:19.231" itunes:key="L1" ttm:agent="v1"><span begin="0:14.577" end="0:14.790">あ</span><span begin="0:14.790" end="0:16.658">あ</span><span begin="0:16.658" end="0:16.892">み</span><span begin="0:16.892" end="0:17.127">ず</span><span begin="0:17.127" end="0:17.367">い</span><span begin="0:17.367" end="0:17.601">ろ</span><span begin="0:17.601" end="0:17.955">の</span><span begin="0:17.955" end="0:19.231">雨</span></p><p begin="0:20.365" end="0:24.319" itunes:key="L2" ttm:agent="v1"><span begin="0:20.365" end="0:20.601">私</span><span begin="0:20.601" end="0:20.866">の</span><span begin="0:20.866" end="0:21.428">肩</span><span begin="0:21.428" end="0:21.900">を</span><span begin="0:21.900" end="0:22.277">抱</span><span begin="0:22.277" end="0:22.507">い</span><span begin="0:22.507" end="0:22.969">て</span><span begin="0:22.969" end="0:23.303">つ</span><span begin="0:23.303" end="0:23.585">つ</span><span begin="0:23.585" end="0:23.825">ん</span><span begin="0:23.825" end="0:24.319">で</span></p><p begin="0:24.549" end="0:27.256" itunes:key="L3" ttm:agent="v1"><span begin="0:24.549" end="0:24.820">降</span><span begin="0:24.820" end="0:25.076">り</span><span begin="0:25.076" end="0:25.296">続</span><span begin="0:25.296" end="0:25.499">く</span><span begin="0:25.499" end="0:27.256">の</span></p><p begin="0:29.523" end="0:34.551" itunes:key="L4" ttm:agent="v1"><span begin="0:29.523" end="0:29.765">あ</span><span begin="0:29.765" end="0:31.594">あ</span><span begin="0:31.594" end="0:31.809">く</span><span begin="0:31.809" end="0:31.994">ず</span><span begin="0:31.994" end="0:32.206">れ</span><span begin="0:32.206" end="0:32.403">て</span><span begin="0:32.403" end="0:32.650">し</span><span begin="0:32.650" end="0:32.895">ま</span><span begin="0:32.895" end="0:34.551">え</span></p><p begin="0:35.333" end="0:39.591" itunes:key="L5" ttm:agent="v1"><span begin="0:35.333" end="0:35.560">あ</span><span begin="0:35.560" end="0:35.770">と</span><span begin="0:35.770" end="0:35.979">か</span><span begin="0:35.979" end="0:36.192">た</span><span begin="0:36.192" end="0:36.454">も</span><span begin="0:36.454" end="0:36.725">な</span><span begin="0:36.725" end="0:37.246">く</span><span begin="0:37.246" end="0:37.572">流</span><span begin