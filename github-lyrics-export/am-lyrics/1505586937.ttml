<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Rainych</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Datenkou</songwriter><songwriter>Amala Zandile Dlamini</songwriter><songwriter>TYSON TRAX</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">直到夜尽天明 请一直陪在我身边</text><text for="L2">就算给你暗示 你也不愿说出口吗？</text><text for="L3">完全毫无所觉 我已没有办法</text><text for="L4">快点说你也一样渴望我</text><text for="L5">直到夜尽天明 请一直陪在我身边</text><text for="L6">就算给你暗示 你也不愿说出口吗？</text><text for="L7">完全毫无所觉 我已没有办法</text><text for="L8">快点说你也一样渴望我</text><text for="L9">不知何时开始 已感受不到你的爱</text><text for="L10">你也从不挑明 你到底是怎么了</text><text for="L11">快告诉我 我要怎么做你才满意</text><text for="L12">隐藏的心事被看穿</text><text for="L13">想要放弃却又无法放弃</text><text for="L14">这样继续下去也无妨</text><text for="L15">与你相互发起攻势</text><text for="L16">如果你也这样想</text><text for="L17">不说出来可不行</text><text for="L18">直到夜尽天明 请一直陪在我身边</text><text for="L19">就算给你暗示 你也不愿说出口吗？</text><text for="L20">完全毫无所觉 我已没有办法</text><text for="L21">快点说你也一样渴望我</text><text for="L22">直到夜尽天明 请一直陪在我身边</text><text for="L23">就算给你暗示 你也不愿说出口吗？</text><text for="L24">完全毫无所觉 我已没有办法</text><text for="L25">快点说你也一样渴望我</text><text for="L26">抬头挺胸 屏住呼吸</text><text for="L27">身着从未曾见过的裙子</text><text for="L28">再没有如此美丽的人了</text><text for="L29">不敢相信我也可以让你哑口无言吧</text><text for="L30">肆意妄为 勇敢去爱吧</text><text for="L31">把我的一切据为己有</text><text for="L32">男孩 别再观望 专注一点</text><text for="L33">无需再有顾虑</text><text for="L34">快来攻占我的心</text><text for="L35">坦诚地说出来吧</text><text for="L36">你知道你想要眼前的这个女人</text><text for="L37">尽请将我品尝吧</text><text for="L38">就算身边的人都反对</text><text for="L39">我也要和你在一起</text><text for="L40">我的朋友都说我失去理智</text><text for="L41">但你就是比任何人都真诚 无可代替</text><text for="L42">你梦寐以求的一切 我全都拥有</text><text for="L43">直到夜尽天明 请一直陪在我身边</text><text for="L44">就算给你暗示 你也不愿说出口吗？</text><text for="L45">完全毫无所觉 我已没有办法</text><text for="L46">快点说你也一样渴望我</text><text for="L47">即使直到黎明 都在向你暗示</text><text for="L48">也完全毫无所觉</text><text for="L49">快点说你也一样渴望我</text><text for="L50">直到夜尽天明 请一直陪在我身边</text><text for="L51">就算给你暗示 你也不愿说出口吗？</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Chorus"><p begin="0:10.834" end="0:14.594" itunes:key="L1" ttm:agent="v1"><span begin="0:10.834" end="0:11.339">夜</span><span begin="0:11.339" end="0:11.923">朝</span><span begin="0:11.923" end="0:12.234">ま</span><span begin="0:12.234" end="0:12.372">で</span><span begin="0:12.669" end="0:12.828">ず</span><span begin="0:12.828" end="0:12.987">っ</span><span begin="0:12.987" end="0:13.204">と</span><span begin="0:13.204" end="0:13.490">そ</span><span begin="0:13.490" end="0:13.786">ば</span><span begin="0:13.786" end="0:14.098">に</span><span begin="0:14.099" end="0:14.411">い</span><span begin="0:14.411" end="0:14.594">て</span></p><p begin="0:14.866" end="0:18.988" itunes:key="L2" ttm:agent="v1"><span begin="0:14.866" end="0:15.371">合</span><span begin="0:15.371" end="0:15.620">図</span><span begin="0:15.620" end="0:15.899">を</span><span begin="0:15.899" end="0:16.178">し</span><span begin="0:16.178" end="0:16.402">た</span><span begin="0:16.403" end="0:16.627">っ</span><span begin="0:16.627" end="0:16.795">て</span><span begin="0:17.035" end="0:17.266">言</span><span begin="0:17.266" end="0:17.523">わ</span><span begin="0:17.523" end="0:17.810">な</span><span begin="0:17.810" end="0:18.419">い</span><span begin="0:18.419" end="0:18.807">の</span><span begin="0:18.807" end="0:18.988">？</span></p><p begin="0:19.452" end="0:23.229" itunes:key="L3" ttm:agent="v1"><span begin="0:19.452" end="0:19.708">全</span><span begin="0:19.708" end="0:19.949">然</span><span begin="0:19.949" e