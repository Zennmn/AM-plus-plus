<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">松原みき (まつばら みき)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>三浦徳子</songwriter><songwriter>林哲司</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">To you yes my love to you</text><text for="L2">Yes my love to you you to you</text><text for="L3">我就是我 你也不过是你</text><text for="L4">总感觉不过是昨晚说过的</text><text for="L5">灰色的夹克衫上</text><text for="L6">沾着似曾相识的咖啡污渍</text><text for="L7">还是老样子呢</text><text for="L8">橱窗玻璃上映出二人的身影</text><text for="L9">留在我的身旁</text><text for="L10">敲响深夜的门</text><text for="L11">哭着求你不要回去 那个时刻</text><text for="L12">如今鲜明地浮现在眼前</text><text for="L13">留在我的身旁</text><text for="L14">重复着你的口头禅</text><text for="L15">拥抱着两人共处的瞬间</text><text for="L16">依然没有忘记</text><text for="L17">珍藏着这份美好</text><text for="L18">“恋与爱是不同的概念”</text><text for="L19">总感觉不过是昨晚说过的</text><text for="L20">第二个冬季已来临</text><text for="L21">你的心也离我远去</text><text for="L22">只要回过头来</text><text for="L23">就感觉你还在那里</text><text for="L24">留在我的身旁</text><text for="L25">敲响深夜的门</text><text for="L26">心中留下一个空洞 那个时刻</text><text for="L27">如今鲜明地浮现在眼前</text><text for="L28">留在我的身旁</text><text for="L29">为了排遣这份寂寞</text><text for="L30">放下唱机的唱针</text><text for="L31">反复地播放着同一段旋律</text><text for="L32">留在我的身旁</text><text for="L33">敲响深夜的门</text><text for="L34">哭着求你不要回去 那个时刻</text><text for="L35">如今鲜明地浮现在眼前</text><text for="L36">留在我的身旁</text><text for="L37">重复着你的口头禅</text><text for="L38">拥抱着两人共处的瞬间</text><text for="L39">依然没有忘记 温暖着这份美好</text><text for="L40">留在我的身旁</text><text for="L41">敲响深夜的门</text><text for="L42">哭着求你不要回去 那个时刻</text><text for="L43">如今鲜明地浮现在眼前</text><text for="L44">留在我的身旁</text><text for="L45">重复着你的口头禅</text><text for="L46">拥抱着两人共处的瞬间</text><text for="L47">依然没有忘记 温暖着这份美好</text><text for="L48">留在我的身旁</text><text for="L49">敲响深夜的门</text><text for="L50">哭着求你不要回去 那个时刻</text><text for="L51">如今鲜明地浮现在眼前</text><text for="L52">留在我的身旁</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Intro"><p begin="0:00.638" end="0:06.918" itunes:key="L1" ttm:agent="v1"><span ttm:role="x-bg" begin="0:00.638" end="0:06.918">(<span begin="0:00.638" end="0:00.878">To</span> <span begin="0:00.878" end="0:02.678">you</span> <span begin="0:03.128" end="0:03.738">yes</span> <span begin="0:03.738" end="0:03.958">my</span> <span begin="0:03.958" end="0:04.628">love</span> <span begin="0:04.758" end="0:05.218">to</span> <span begin="0:05.218" end="0:06.918">you</span></span></p><p begin="0:07.548" end="0:17.948" itunes:key="L2" ttm:agent="v1"><span ttm:role="x-bg" begin="0:07.548" end="0:17.948"><span begin="0:07.548" end="0:08.118">Yes</span> <span begin="0:08.118" end="0:08.388">my</span> <span begin="0:08.388" end="0:09.088">love</span> <span begin="0:09.198" end="0:09.498">to</span> <span begin="0:09.498" end="0:11.498">you</span> <span begin="0:11.988" end="0:13.698">you</span> <span begin="0:13.918" end="0:14.118">to</span> <span begin="0:14.118" end="0:17.948">you</span>)</span></p></div><div itunes:song-part="Verse"><p begin="0:23.338" end="0:28.948" itunes:key="L3" ttm:agent="v1"><span begin="0:23.338" end="0:24.058">私</span><span begin="0:24.058" end="0:24.398">は</span><span begin="0:24.398" end="0:25.388">私</span> <span begin="0:25.568" end="0:26.168">貴方</span><span begin="0:26.168" end="0:26.878">は</span><span begin="0:26.878" end="0:27.338">貴方</span><span begin="0:27.338" end="0:28.948">と</span></p><p begin="0:32.536" end="0:37.916" itunes:key="L4" ttm:agent="v1"><span begin="0:32.536" end="0:32.936">昨夜</span><span begin="0:32.936" end="0:33.246">言</span><span begin="0:33.246" 