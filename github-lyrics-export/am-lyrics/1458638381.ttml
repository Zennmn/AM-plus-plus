<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Lil Nas X</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">Billy Ray Cyrus</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Billy Ray Cyrus</songwriter><songwriter>Montero Lamar Hill</songwriter><songwriter>Michael Trent Reznor</songwriter><songwriter>Atticus Matthew Ross</songwriter><songwriter>Jocelyn Donald</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">Oh oh-oh</text><text for="L2">Oh</text><text for="L3">我要在老城小路上 挥鞭策马</text><text for="L4">势必要骑到筋疲力尽才罢休</text><text for="L5">我要在老城小路上 挥鞭策马</text><text for="L6">势必要骑到筋疲力尽才罢休</text><text for="L7">我牵着骏马</text><text for="L8">马掌已上钉</text><text for="L9">头戴磨砂黑帽</text><text for="L10">脚踩配套黑靴</text><text for="L11">骑着骏马</text><text for="L12">你开你的保时捷</text><text for="L13">我在山谷穿梭之时</text><text for="L14">你的车还没开出自家门廊</text><text for="L15">无需他人对我瞎指挥</text><text for="L16">你别对我指手画脚</text><text for="L17">无需他人对我瞎指挥</text><text for="L18">你别对我指手画脚</text><text for="L19">开着拖拉机</text><text for="L20">蓄势狂驰</text><text for="L21">背着我的宝贝偷情</text><text for="L22">你可以去问问她</text><text for="L23">我的生活像电影一样精彩</text><text for="L24">骑着公牛 带着个傻瓜</text><text for="L25">古驰牌的牛仔帽</text><text for="L26">Wrangler(牛仔品牌)加身 享受着奢华</text><text for="L27">无需他人对我瞎指挥</text><text for="L28">你别对我指手画脚</text><text for="L29">无需他人对我瞎指挥</text><text for="L30">你别对我指手画脚</text><text for="L31">我要在老城小路上 挥鞭策马</text><text for="L32">势必要骑到筋疲力尽才罢休</text><text for="L33">我要在老城小路上 挥鞭策马</text><text for="L34">势必要骑到筋疲力尽才罢休</text><text for="L35">压低帽檐 招摇过市 像摇滚明星一样风光</text><text for="L36">花巨款抱回我崭新的吉他</text><text for="L37">我的宝贝购物就停不下来 钻石戒指 芬迪运动胸衣</text><text for="L38">驾驶着玛莎拉蒂跑车 一路狂飙</text><text for="L39">毫无压力 一直这样轻松自在的生活</text><text for="L40">我就像抽着万宝路的牛仔 潇洒肆意</text><text for="L41">真希望我还能回到那老城小路</text><text for="L42">势必要疯狂到尽兴才罢休</text><text for="L43">我要在老城小路上 挥鞭策马</text><text for="L44">势必要骑到筋疲力尽才罢休</text><text for="L45">我要在老城小路上 挥鞭策马</text><text for="L46">势必要骑到筋疲力尽才罢休</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Intro"><p begin="0:02.634" end="0:08.081" itunes:key="L1" ttm:agent="v2"><span begin="0:02.634" end="0:05.365">Oh</span> <span begin="0:05.365" end="0:07.123">oh-</span><span begin="0:07.123" end="0:08.081">oh</span></p><p begin="0:09.519" end="0:11.333" itunes:key="L2" ttm:agent="v2"><span begin="0:09.519" end="0:11.333">Oh</span></p></div><div itunes:song-part="Chorus"><p begin="0:12.930" end="0:16.990" itunes:key="L3" ttm:agent="v2"><span begin="0:12.930" end="0:13.467">Yeah</span> <span begin="0:13.467" end="0:13.706">I'm</span> <span begin="0:13.706" end="0:14.142">gonna</span> <span begin="0:14.142" end="0:14.537">take</span> <span begin="0:14.537" end="0:14.960">my</span> <span begin="0:14.960" end="0:15.395">horse</span> <span begin="0:15.395" end="0:15.618">to</span> <span begin="0:15.618" end="0:15.896">the</span> <span begin="0:15.896" end="0:16.116">old</span> <span begin="0:16.116" end="0:16.536">town</span> <span begin="0:16.536" end="0:16.990">road</span></p><p begin="0:16.990" end="0:20.344" itunes:key="L4" ttm:agent="v2"><span begin="0:16.990" end="0:17.192">I'm</span> <span begin="0:17.192" end="0:18.057">gonna</span> <span begin="0:18.057" end="0:18.942">ride</span> <span begin="0:18.942" end="0:19.130">'til</span> <span begin="0:19.130" end="0:19.366">I</span> <span begin="0:19.366" end="0:19.857">can't</span> <span begin="0:19.857" end="0:20.086">no</span> <span begin="0:20.086" end="0:20.344">more</span></p><p begin="0:20.344" end="0:23.985" itunes:key="L5" ttm:agent="v2