tm:role="x-bg" begin="0:44.628" end="0:44.728"><span begin="0:44.628" end="0:44.628">(</span><span begin="0:44.628" end="0:44.668">流</span><span begin="0:44.668" end="0:44.728">)</span></span><span begin="0:44.728" end="0:44.998">れ</span><span begin="0:44.998" end="0:45.488">た</span><span begin="0:45.488" end="0:45.788">の</span><span begin="0:45.788" end="0:45.998">に</span></p><p begin="0:46.018" end="0:49.948" itunes:key="L7" ttm:agent="v1"><span begin="0:46.018" end="0:46.198">あ</span><span begin="0:46.198" end="0:46.518">な</span><span begin="0:46.518" end="0:46.758">た</span><span begin="0:46.758" end="0:47.018">は</span><span begin="0:47.018" end="0:47.278">ま</span><span begin="0:47.278" end="0:47.798">だ</span><span begin="0:47.798" end="0:48.248">謎</span><span begin="0:48.248" end="0:48.568">に</span><span begin="0:48.568" end="0:48.798">包</span><span begin="0:48.798" end="0:49.028">ま</span><span begin="0:49.028" end="0:49.258">れ</span><span begin="0:49.258" end="0:49.448">た</span><span begin="0:49.448" end="0:49.778">ま</span><span begin="0:49.778" end="0:49.948">ま</span></p><p begin="0:49.978" end="0:53.798" itunes:key="L8" ttm:agent="v1"><span ttm:role="x-bg" begin="0:49.978" end="0:50.818"><span begin="0:49.978" end="0:49.978">(</span><span begin="0:49.978" end="0:50.678">質</span><span begin="0:50.678" end="0:50.818">)</span></span><span begin="0:50.818" end="0:50.978">問</span><span begin="0:50.978" end="0:51.528">に</span><span begin="0:51.528" end="0:52.068">は</span><span begin="0:52.068" end="0:52.448">曖</span><span begin="0:52.448" end="0:52.828">昧</span><span begin="0:52.828" end="0:53.338">な</span><span begin="0:53.338" end="0:53.798">answer</span></p><p begin="0:54.068" end="0:58.138" itunes:key="L9" ttm:agent="v1"><span begin="0:54.068" end="0:54.218">あ</span><span begin="0:54.218" end="0:54.518">な</span><span begin="0:54.518" end="0:54.648">た</span><span begin="0:54.648" end="0:54.778">の</span><span begin="0:54.778" end="0:55.008">こ</span><span begin="0:55.008" end="0:55.348">と</span><span begin="0:55.348" end="0:55.548">を</span><span begin="0:55.548" end="0:56.088">私</span><span begin="0:56.088" end="0:56.248">は</span><span begin="0:56.248" end="0:56.748">何</span><span begin="0:56.748" end="0:56.998">も</span><span begin="0:56.998" end="0:57.258">知</span><span begin="0:57.258" end="0:57.738">ら</span><span begin="0:57.738" end="0:58.128">な</span><span begin="0:58.128" end="0:58.138">い</span></p></div><div itunes:song-part="Chorus"><p begin="0:58.158" end="1:01.458" itunes:key="L10" ttm:agent="v1"><span begin="0:58.158" end="0:58.558">サ</span><span begin="0:58.558" end="0:58.788">ヨ</span><span begin="0:58.788" end="0:59.008">ナ</span><span begin="0:59.008" end="0:59.438">ラ</span><span ttm:role="x-bg" begin="0:59.568" end="1:01.458"><span begin="0:59.568" end="0:59.858">い</span><span begin="0:59.858" end="1:00.028">や</span><span begin="1:00.028" end="1:00.278">言</span><span begin="1:00.278" end="1:00.518">わ</span><span begin="1:00.518" end="1:00.788">せ</span><span begin="1:00.788" end="1:01.028">な</span><span begin="1:01.028" end="1:01.458">い</span></span></p><p begin="1:01.568" end="1:06.298" itunes:key="L11" ttm:agent="v1"><span begin="1:01.568" end="1:02.018">嘘</span><span begin="1:02.018" end="1:02.278">よ</span><span begin="1:02.278" end="1:02.778">傍</span><span begin="1:02.778" end="1:03.268">に</span><span begin="1:03.268" end="1:03.278">い</span><span begin="1:03.278" end="1:03.628">て</span><span ttm:role="x-bg" begin="1:03.628" end="1:06.298"><span begin="1:03.628" end="1:04.068">君</span><span begin="1:04.068" end="1:04.278">を</span><span begin="1:04.278" end="1:04.528">ず</span><span begin="1:04.528" end="1:04.778">っ</span><span begin="1:04.778" end="1:05.028">と</span><span begin="1:05.028" end="1:05.393">離</span><span begin="1:05.393" end="1:05.758">さ</span><span begin="1:05.758" end="1:06.088">な</span><span begin="1:06.088" end="1:06.298">い</span></span></p><p begin="1:06.318" end="1:09.408" itunes:key="L12" t