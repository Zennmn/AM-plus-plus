<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">緑黄色社会</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>長屋晴子</songwriter><songwriter>小林壱誓</songwriter><songwriter>peppe</songwriter><songwriter>穴見真吾</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">不就是现在吗?</text><text for="L2">熊熊沸腾着</text><text for="L3">只知道沉睡的正义</text><text for="L4">即使是这样的我</text><text for="L5">也想要成为你的英雄</text><text for="L6">帅气的你</text><text for="L7">并不会以我为依靠</text><text for="L8">说的也是啊</text><text for="L9">毕竟我现在都还在迷茫</text><text for="L10">能牵起我的手吗</text><text for="L11">我们等价交换</text><text for="L12">就像你是我的英雄那样</text><text for="L13">不就是现在吗?</text><text for="L14">熊熊沸腾着</text><text for="L15">这样的我也藏着正义之心</text><text for="L16">被难以抑制的冲动驱使着</text><text for="L17">回过神来已经握住了你的手</text><text for="L18">到底</text><text for="L19">背着那么重的负担</text><text for="L20">准备去哪里呢</text><text for="L21">喂 等一等</text><text for="L22">试着匀给我一些吧?</text><text for="L23">总是轻易相信的我</text><text for="L24">和害怕去相信的你</text><text for="L25">究竟谁才比较正确</text><text for="L26">没有人知道答案</text><text for="L27">在只有我们的世界</text><text for="L28">等价交换</text><text for="L29">在相互弥补的拂晓 想与你做同一个梦</text><text for="L30">为你的帅气而苦恼</text><text for="L31">让你变得孤单一人</text><text for="L32">都是我的错呢 对不起</text><text for="L33">但是应该面对现实</text><text for="L34">现在正该是我来拯救你的时候</text><text for="L35">不要独自怀着悲伤相信我</text><text for="L36">希望你能依靠我</text><text for="L37">不就是现在吗?</text><text for="L38">熊熊沸腾着</text><text for="L39">这样的我心中也沉睡着正义</text><text for="L40">被难以抑制的冲动驱使着</text><text for="L41">回过神来已经握住了你的手</text><text for="L42">无法放下你</text><text for="L43">背着那么重的负担</text><text for="L44">准备去哪里呢</text><text for="L45">稍微地</text><text for="L46">试着匀给我一些吧?</text><text for="L47">即使是这样的我</text><text for="L48">也想成为你的英雄啊</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:00.995" end="0:02.128" itunes:key="L1" ttm:agent="v1"><span begin="0:00.995" end="0:01.264">今</span><span begin="0:01.264" end="0:01.334">な</span><span begin="0:01.335" end="0:01.405">ん</span><span begin="0:01.405" end="0:01.518">じ</span><span begin="0:01.518" end="0:01.631">ゃ</span><span begin="0:01.631" end="0:01.845">な</span><span begin="0:01.845" end="0:01.968">い</span><span begin="0:01.968" end="0:02.128">?</span></p><p begin="0:02.337" end="0:04.064" itunes:key="L2" ttm:agent="v1"><span begin="0:02.337" end="0:02.480">メ</span><span begin="0:02.480" end="0:02.649">ラ</span><span begin="0:02.649" end="0:02.864">メ</span><span begin="0:02.864" end="0:03.153">ラ</span><span begin="0:03.153" end="0:03.367">と</span><span begin="0:03.367" end="0:03.593">た</span><span begin="0:03.593" end="0:03.852">ぎ</span><span begin="0:03.852" end="0:04.064">れ</span></p><p begin="0:04.288" end="0:07.205" itunes:key="L3" ttm:agent="v1"><span begin="0:04.288" end="0:04.873">眠</span><span begin="0:04.874" end="0:05.243">っ</span><span begin="0:05.243" end="0:05.413">て</span><span begin="0:05.414" end="0:05.584">い</span><span begin="0:05.584" end="0:05.841">る</span><span begin="0:05.841" end="0:06.008">だ</span><span begin="0:06.008" end="0:06.144">け</span><span begin="0:06.144" end="0:06.453">の</span><span begin="0:06.453" end="0:06.941">正</span><span begin="0:06.941" end="0:07.205">義</span></p><p begin="0:07.580" end="0:09.024" itunes:key="L4" ttm:agent="v1"><span begin="0:07.580" end="0:07.827">こ</span><span begin="0:07.827" end="0:08.074">ん</span><span begin="0:08.075" end="0:08.293">な</span><span begin="0:08.293" end="0:08.808">僕</span><span begin="0:08.808" end="0:09.024">も</span></p><p begin="0:09.317" end="0:14.805" itunes:key="L5" ttm:agent="v1"><span begin="0:09.317" end="0:09.748">君</span><span begin="0:09.748" end="0:10.000">の</span><span begin="0:10.000" end="0:10.194">ヒ</span><span begin="0:10.194" end="0:10.388">ー</span><span begin="0:10.389" end="0:10.589">ロ</span><span begin="0:10.589" end="0:10.653">ー</span><span begin="0:10.823" end="0:11.021">に</span><span begin="0:11.021" end="0:11.218">な</span><span begin="0:11.218" end="0:11.413">り</span><span begin="0:11.413" end="0:11.613">た</span><span begin="0:11.613" end="0:12.117">い</span><span begin="0:12.117" end="0:12.317">の</span><span begin="0:12.317" end="0:14.805">さ</span></p></div><div itunes:song-part="PreChorus"><p begin="0:29.256" end="0:31.688" itunes:key="L6" ttm:agent="v1"><span begin="0:29.256" end="0:29.480">か</span><span begin="0:29.480" end="0:29.704">っ</span><span begin="0:29.704" end="0:29.936">こ</span><span begin="0:29.936" end="0:30.116">い</span><span begin="0:30.116" end="0:30.296">い</span><span begin="0:30.296" end="0:30.801">君</span><span begin="0:30.801" end="0:31.248">に</span><span begin="0:31.248" end="0:31.688">は</span></p><p begin="0:32.188" end="0:35.780" itunes:key="L7" ttm:agent="v1"><span begin="0:32.188" end="0:32.579">僕</span><span begin="0:32.579" end="0:32.687">じ</span><span begin="0:32.687" end="0:32.795">ゃ</span><span begin="0:32.795" end="0:33.204">頼</span><span begin="0:33.204" end="0:33.428">り</span><span begin="0:33.428" end="0:33.636">な</span><span begin="0:33.636" end="0:33.844">い</span><span begin="0:33.844" end="0:34.053">の</span><span begin="0:34.053" end="0:34.276">か</span><span begin="0:34.276" end="0:34.508">な</span><span begin="0:34.508" end="0:34.740">ん</span><span begin="0:34.740" end="0:35.780">て</span></p><p begin="0:36.202" end="0:37.631" itunes:key="L8" ttm:agent="v1"><span begin="0:36.202" end="0:36.412">そ</span><span begin="0:36.412" end="0:36.531">り</span><span begin="0:36.531" end="0:36.650">ゃ</span><span begin="0:36.650" end="0:36.891">そ</span><span begin="0:36.892" end="0:37.133">う</span><span begin="0:37.133" end="0:37.322">だ</span><span begin="0:37.322" end="0:37.540">よ</span><span begin="0:37.540" end="0:37.631">な</span></p><p begin="0:37.822" end="0:42.670" itunes:key="L9" ttm:agent="v1"><span begin="0:37.822" end="0:38.030">だ</span><span begin="0:38.030" end="0:38.238">っ</span><span begin="0:38.239" end="0:38.800">て</span><span begin="0:39.055" end="0:39.463">今</span><span begin="0:39.463" end="0:39.719">も</span><span begin="0:39.719" end="0:39.931">こ</span><span begin="0:39.932" end="0:40.144">う</span><span begin="0:40.144" end="0:40.351">し</span><span begin="0:40.351" end="0:40.585">て</span><span begin="0:40.585" end="0:41.007">迷</span><span begin="0:41.007" end="0:41.223">っ</span><span begin="0:41.224" end="0:41.660">て</span><span begin="0:41.660" end="0:42.670">る</span></p></div><div itunes:song-part="Chorus"><p begin="0:45.144" end="0:46.676" itunes:key="L10" ttm:agent="v1"><span begin="0:45.144" end="0:45.284">手</span><span begin="0:45.284" end="0:45.420">を</span><span begin="0:45.420" end="0:45.492">取</span><span begin="0:45.492" end="0:45.564">っ</span><span begin="0:45.565" end="0:45.700">て</span><span begin="0:45.700" end="0:45.850">く</span><span begin="0:45.850" end="0:45.988">れ</span><span begin="0:45.988" end="0:46.174">な</span><span begin="0:46.174" end="0:46.388">い</span><span begin="0:46.388" end="0:46.676">か</span></p><p begin="0:48.640" end="0:50.212" itunes:key="L11" ttm:agent="v1"><span begin="0:48.640" end="0:48.831">ギ</span><span begin="0:48.831" end="0:48.983">ブ</span><span begin="0:48.983" end="0:49.255">と</span><span begin="0:49.255" end="0:49.430">テ</span><span begin="0:49.431" end="0:49.606">イ</span><span begin="0:49.606" end="0:49.906">ク</span><span begin="0:49.906" end="0:50.212">さ</span></p><p begin="0:52.071" end="0:56.321" itunes:key="L12" ttm:agent="v1"><span begin="0:52.071" end="0:52.503">君</span><span begin="0:52.503" end="0:52.663">が</span><span begin="0:52.663" end="0:53.158">僕</span><span begin="0:53.158" end="0:53.384">の</span><span begin="0:53.384" end="0:53.611">ヒ</span><span begin="0:53.611" end="0:53.838">ー</span><span begin="0:53.838" end="0:54.094">ロ</span><span begin="0:54.095" end="0:54.351">ー</span><span begin="0:54.351" end="0:54.535">だ</span><span begin="0:54.535" end="0:54.719">っ</span><span begin="0:54.719" end="0:55.015">た</span><span begin="0:55.015" end="0:55.095">よ</span><span begin="0:55.095" end="0:55.175">う</span><span begin="0:55.175" end="0:56.321">に</span></p></div><div itunes:song-part="Verse"><p begin="0:56.354" end="0:57.816" itunes:key="L13" ttm:agent="v1"><span begin="0:56.354" end="0:56.664">今</span><span begin="0:56.664" end="0:56.773">な</span><span begin="0:56.774" end="0:56.883">ん</span><span begin="0:56.883" end="0:56.993">じ</span><span begin="0:56.993" end="0:57.103">ゃ</span><span begin="0:57.103" end="0:57.463">な</span><span begin="0:57.463" end="0:57.615">い</span><span begin="0:57.615" end="0:57.816">?</span></p><p begin="0:57.993" end="0:59.737" itunes:key="L14" ttm:agent="v1"><span begin="0:57.993" end="0:58.144">メ</span><span begin="0:58.144" end="0:58.308">ラ</span><span begin="0:58.308" end="0:58.552">メ</span><span begin="0:58.552" end="0:58.783">ラ</span><span begin="0:58.783" end="0:59.017">と</span><span begin="0:59.017" end="0:59.239">た</span><span begin="0:59.239" end="0:59.481">ぎ</span><span begin="0:59.481" end="0:59.737">る</span></p><p begin="0:59.985" end="1:03.247" itunes:key="L15" ttm:agent="v1"><span begin="0:59.985" end="1:00.192">こ</span><span begin="1:00.193" end="1:00.400">ん</span><span begin="1:00.400" end="1:00.848">な</span><span begin="1:00.848" end="1:01.266">僕</span><span begin="1:01.266" end="1:01.464">に</span><span begin="1:01.464" end="1:01.672">も</span><span begin="1:01.672" end="1:02.080">潜</span><span begin="1:02.080" end="1:02.295">む</span><span begin="1:02.295" end="1:02.759">正</span><span begin="1:02.759" end="1:02.991">義</span><span begin="1:02.991" end="1:03.247">が</span></p><p begin=