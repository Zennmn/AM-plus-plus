<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい (当山美玲)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>MIREI</songwriter><songwriter>Victor Sagfors</songwriter><songwriter>Derrick Hoh</songwriter><songwriter>Timo Oiva</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">红色和蓝色的杯子</text><text for="L2">你借给我的T恤</text><text for="L3">只有我一个人待在两个人的房间里</text><text for="L4">喜欢喷的香水</text><text for="L5">发出的香气</text><text for="L6">在经常碰面的车站也散发着味道</text><text for="L7">能够忘记一切这句话</text><text for="L8">请不要说得那么简单</text><text for="L9">但在今天</text><text for="L10">我却痛苦到无法再忍耐</text><text for="L11">曾经的第一次</text><text for="L12">曾经非常喜欢你</text><text for="L13">就算被你玩弄</text><text for="L14">我也感觉没关系</text><text for="L15">但我真的</text><text for="L16">始终相信</text><text for="L17">你说你爱我这句话</text><text for="L18">你在哪里</text><text for="L19">请抱住我</text><text for="L20">好寂寞呀</text><text for="L21">就算我被人</text><text for="L22">说成是傻瓜</text><text for="L23">我也仍然无法讨厌你</text><text for="L24">My first heartbreak</text><text for="L25">游乐园水族馆</text><text for="L26">烟花下的彩灯</text><text for="L27">无论去到哪里两个人在一起就好</text><text for="L28">在LINE上的吵架</text><text for="L29">连着发出好多笨蛋的贴图</text><text for="L30">闪耀的只有回忆</text><text for="L31">能够忘记一切这句话</text><text for="L32">请不要说得那么简单</text><text for="L33">但在今天</text><text for="L34">我却痛苦到无法再忍耐</text><text for="L35">曾经的第一次</text><text for="L36">曾经非常喜欢你</text><text for="L37">相信你也是同样的心情</text><text for="L38">我绝对不愿承认</text><text for="L39">没有永远这种事</text><text for="L40">你在哪里</text><text for="L41">请抱住我</text><text for="L42">好寂寞呀</text><text for="L43">就算我被人</text><text for="L44">说成是傻瓜</text><text for="L45">我也仍然无法讨厌你</text><text for="L46">My first heartbreak</text><text for="L47">Heartbreak heartbreak</text><text for="L48">I got my first heartbreak heartbreak</text><text for="L49">Heartbreak heartbreak</text><text for="L50">I got my first heartbreak heartbreak</text><text for="L51">曾经的第一次</text><text for="L52">曾经非常喜欢你</text><text for="L53">就算被你玩弄</text><text for="L54">我也感觉没关系</text><text for="L55">但我真的</text><text for="L56">始终相信</text><text for="L57">你说你爱我这句话</text><text for="L58">你在哪里</text><text for="L59">请抱住我</text><text for="L60">好寂寞呀</text><text for="L61">就算我被人</text><text for="L62">说成是傻瓜</text><text for="L63">我也仍然无法讨厌你</text><text for="L64">My first heartbreak</text><text for="L65">My one and only heartbreak</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:12.739" end="0:14.803" itunes:key="L1" ttm:agent="v1"><span begin="0:12.739" end="0:13.032">赤</span><span begin="0:13.032" end="0:13.379">と</span><span begin="0:13.379" end="0:13.811">青</span><span begin="0:13.811" end="0:13.984">の</span><span begin="0:13.984" end="0:14.139">カ</span><span begin="0:14.139" end="0:14.376">ッ</span><span begin="0:14.376" end="0:14.803">プ</span></p><p begin="0:15.112" end="0:17.442" itunes:key="L2" ttm:agent="v1"><span begin="0:15.112" end="0:15.362">貸</span><span begin="0:15.362" end="0:15.529">し</span><span begin="0:15.529" end="0:15.750">て</span><span begin="0:15.750" end="0:15.919">く</span><span begin="0:15.919" end="0:16.187">れ</span><span begin="0:16.187" end="0:16.433">た</span><span begin="0:16.433" end="0:16.739">T</span><span begin="0:16.739" end="0:16.913">シ</span><span begin="0:16.913" end="0:17.070">ャ</span><span begin="0:17.070" end="0:17.442">ツ</span></p><p begin="0:17.673" end="0:21.800" itunes:key="L3" ttm:agent="v1"><span begin="0:17.673" end="0:18.096">2</span><span begin="0:18.096" end="0:18.318">人</span><span begin="0:18.318" end="0:18.623">の</span><span be