<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">ずっと真夜中でいいのに。 (永远是深夜有多好｡)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter><songwriter>ラムシーニ</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">“我说的不是你”</text><text for="L2">多希望是我想多了</text><text for="L3">都暴露了还是想要掩盖</text><text for="L4">别把我列为那样的对象</text><text for="L5">也不想被一一编号</text><text for="L6">排队等你宠爱</text><text for="L7">不如干脆祝福你</text><text for="L8">拿竹刀狠狠劈过去</text><text for="L9">不依靠谁就会失去庇护所</text><text for="L10">但请不要移开</text><text for="L11">你充满魔力的眼神</text><text for="L12">推特上刺耳的嘲讽声</text><text for="L13">快给我消失吧</text><text for="L14">注意力匪夷所思地集中</text><text for="L15">打开推特发表牢骚</text><text for="L16">用我第七个小号</text><text for="L17">只是段擅长奉献自我的时光</text><text for="L18">直觉如此敏锐真是懊恼</text><text for="L19">能麻木地付出该多轻松</text><text for="L20">可做不到淡然一笑</text><text for="L21">我已掩饰好自己的内心</text><text for="L22">不吝嬉笑怒骂的网友们</text><text for="L23">我对你们只有感谢</text><text for="L24">不用重头再来一遍</text><text for="L25">现在我只想回家睡觉</text><text for="L26">教人低眉颔首的方法</text><text for="L27">让人顺从到不正常</text><text for="L28">不允许把情绪表现出来</text><text for="L29">哭泣到筋疲力尽吧</text><text for="L30">学会清空重置自己吧</text><text for="L31">对我没兴趣就不要管我</text><text for="L32">弄混了难关 难解和几层</text><text for="L33">完全不好笑的玩笑</text><text for="L34">只是段百无聊赖的时光</text><text for="L35">直觉如此敏锐真是懊恼</text><text for="L36">能麻木地付出该多轻松</text><text for="L37">可做不到淡然一笑</text><text for="L38">我已掩饰好自己的内心</text><text for="L39">不吝嬉笑怒骂的网友们</text><text for="L40">我对你们只有感谢</text><text for="L41">不用重头再来一遍</text><text for="L42">现在我只想回家睡觉</text><text for="L43">你给的毒莓</text><text for="L44">还未能让你1号对象满足</text><text for="L45">我会一口吃下 让你终生难忘</text><text for="L46">流过的眼泪 错误的答案之类</text><text for="L47">直到摆脱自相矛盾的理论</text><text for="L48">得到拯救不再纠结</text><text for="L49">直觉如此敏锐真是懊恼</text><text for="L50">能麻木地付出该多轻松</text><text for="L51">可做不到淡然一笑</text><text for="L52">我已掩饰好自己的内心</text><text for="L53">不吝嬉笑怒骂的网友们</text><text for="L54">我对你们只有感谢</text><text for="L55">不用重头再来一遍</text><text for="L56">现在我只想回家睡觉</text><text for="L57">虽然并不想暴露自己心思</text><text for="L58">要是我说希望你知道 会怎样</text><text for="L59">太过敏锐的直觉让我歇斯底里</text><text for="L60">いえい いえい いえい イエイ</text><text for="L61">在空无一人的远方坦然面对</text><text for="L62">遗像 遗咏 遗像 遗咏</text><text for="L63">遗像 遗咏 遗像 尸体</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:19.845" end="0:21.372" itunes:key="L1" ttm:agent="v1"><span begin="0:20.166" end="0:20.353">君</span><span begin="0:20.353" end="0:20.365">の</span><span begin="0:20.365" end="0:20.533">こ</span><span begin="0:20.533" end="0:20.554">と</span><span begin="0:20.554" end="0:20.645">じ</span><span begin="0:20.645" end="0:20.705">ゃ</span><span begin="0:20.705" end="0:20.883">な</span><span begin="0:20.883" end="0:21.243">い</span><span begin="0:21.243" end="0:21.339">よ</span></p><p begin="0:21.712" end="0:23.107" itunes:key="L2" ttm:agent="v1"><span begin="0:21.712" end="0:21.899">気</span><span begin="0:21.899" end="0:21.986">の</span><span begin="0:21.986" end="0:22.014">せ</span><span begin="0:22.014" end="0:22.137">い</span><span begin="0:22.137" end="0:22.345">に</span><span begin="0:22.345" end="0:22.377">し</span><span begin="0:22.377" end="0:22.563">た</span><span begin="0:22.563" end="0:22.923">い</span><span begin="0:22.923" end="0:23.107">よ</span></p><p begin="0:23.290" end="0:24.593" itunes:key="L3" ttm:agent="v1"><span begin="0:23.290" end="0:23.472">ば</span><span begin="0:23.472" end="0:23.656">れ</span><span begin="0:23.656" end="0:23.731">た</span><span begin="0:23.731" end="0:23.769">っ</span><span begin="0:23.770" end="0:23.938">て</span><span begin="0:23.938" end="0:24.024">誤</span><span begin="0:24.024" end="0:24.202">魔</span><span begin="0:24.202" end="0:24.472">化</span><span begin="0:24.472" end="0:24.481">す</span><span begin="0:24.481" end="0:24.593">の</span></p><p begin="0:24.651" end="0:26.097" itunes:key="L4" ttm:agent="v1"><span begin="0:24.651" end="0:25.056">相</span><span begin="0:25.056" end="0:25.336">手</span><span begin="0:25.336" end="0:25.577">に</span><span begin="0:25.577" end="0:25.849">し</span><span begin="0:25.849" end="0:25.880">な</span><span begin="0:25.880" end="0:26.026">い</span><span begin="0:26.026" end="0:26.097">で</span></p><p begin="0:26.425" end="0:27.880" itunes:key="L5" ttm:agent="v1"><span begin="0:26.425" end="0:26.629">背</span><span begin="0:26.629" end="0:26.796">の</span><span begin="0:26.796" end="0:27.000">順</span><span begin="0:27.000" end="0:27.020">あ</span><span begin="0:27.020" end="0:27.144">い</span><span begin="0:27.144" end="0:27.416">う</span><span begin="0:27.416" end="0:27.688">え</span><span begin="0:27.688" end="0:27.880">お</span></p><p begin="0:28.040" end="0:29.462" itunes:key="L6" ttm:agent="v1"><span begin="0:28.040" end="0:28.233">並</span><span begin="0:28.233" end="0:28.417">び</span><span begin="0:28.417" end="0:28.579">た</span><span begin="0:28.579" end="0:28.737">く</span><span begin="0:28.737" end="0:28.766">も</span><span begin="0:28.766" end="0:29.102">な</span><span begin="0:29.102" end="0:29.390">い</span><span begin="0:29.390" end="0:29.462">よ</span></p><p begin="0:29.696" end="0:30.740" itunes:key="L7" ttm:agent="v1"><span begin="0:29.696" end="0:29.832">も</span><span begin="0:29.832" end="0:29.889">う</span><span begin="0:29.889" end="0:30.009">い</span><span begin="0:30.009" end="0:30.079">っ</span><span begin="0:30.079" end="0:30.302">そ</span> <span begin="0:30.302" end="0:30.486">お</span><span begin="0:30.486" end="0:30.512">目</span><span begin="0:30.512" end="0:30.642">出</span><span begin="0:30.642" end="0:30.709">度</span><span begin="0:30.709" end="0:30.740">い</span></p><p begin="0:31.022" end="0:32.656" itunes:key="L8" ttm:agent="v1"><span begin="0:31.022" end="0:31.460">一</span><span begin="0:31.460" end="0:31.744">人</span><span begin="0:31.744" end="0:31.976">を</span><span begin="0:31.976" end="0:32.078">竹</span><span begin="0:32.078" end="0:32.480">刀</span><span begin="0:32.480" end="0:32.656">で</span></p></div><div itunes:song-part="PreChorus"><p begin="0:32.880" end="0:35.814" itunes:key="L9" ttm:agent="v1"><span begin="0:32.880" end="0:33.104">誰</span><span begin="0:33.104" end="0:33.114">か</span><span begin="0:33.114" end="0:33.254">と</span><span begin="0:33.254" end="0:33.413">い</span><span begin="0:33.413" end="0:33.712">な</span><span begin="0:33.712" end="0:34.040">い</span><span begin="0:34.040" end="0:34.464">と</span> <span begin="0:34.464" end="0:34.649">避</span><span begin="0:34.649" end="0:34.745">難</span><span begin="0:34.746" end="0:34.930">場</span><span begin="0:34.930" end="0:35.082">所</span><span begin="0:35.082" end="0:35.142">は</span><span begin="0:35.142" end="0:35.422">な</span><span begin="0:35.422" end="0:35.678">い</span><span begin="0:35.678" end="0:35.814">よ</span></p><p begin="0:36.023" end="0:36.998" itunes:key="L10" ttm:agent="v1"><span begin="0:36.023" end="0:36.214">ミ</span><span begin="0:36.214" end="0:36.390">ラ</span><span begin="0:36.390" end="0:36.542">ク</span><span begin="0:36.542" end="0:36.633">ル</span><span begin="0:36.633" end="0:36.734">な</span><span begin="0:36.734" end="0:36.966">目</span><span begin="0:36.966" end="0:36.998">を</span></p><p begin="0:37.044" end="0:38.919" itunes:key="L11" ttm:agent="v1"><span begin="0:37.044" end="0:37.291">ま</span><span begin="0:37.291" end="0:37.451">だ</span><span begin="0:37.451" end="0:37.620">逸</span><span begin="0:37.620" end="0:37.756">ら</span><span begin="0:37.756" end="0:37.947">せ</span><span begin="0:37.947" end="0:38.259">は</span><span begin="0:38.259" end="0:38.419">し</span><span begin="0:38.419" end="0:38.716">な</span><span begin="0:38.716" end="0:38.863">い</span><span begin="0:38.863" end="0:38.919">で</span></p><p begin="0:39.204" end="0:40.609" itunes:key="L12" ttm:agent="v1"><span begin="0:39.204" end="0:39.396">あ</span><span begin="0:39.396" end="0:39.564">た</span><span begin="0:39.564" end="0:39.732">し</span><span begin="0:39.732" end="0:39.784">を</span><span begin="0:39.784" end="0:40.168">嫌</span><span begin="0:40.168" end="0:40.213">う</span><span begin="0:40.213" end="0:40.569">鳥</span><span begin="0:40.569" end="0:40.609">の</span></p><p begin="0:40.875" end="0:42.175" itunes:key="L13" ttm:agent="v1"><span begin="0:40.875" end="0:40.966">笑</span><span begin="0:40.966" end="0:41.174">い</span><span begin="0:41.174" end="0:41.518">声</span><span begin="0:41.518" end="0:41.525">を</span><span begin="0:41.525" end="0:41.781">消</span><span begin="0:41.781" end="0:41.897">そ</span><span begin="0:41.897" end="0:42.070">う</span><span begin="0:42.071" end="0:42.175">よ</span></p><p begin="0:42.445" end="0:45.097" itunes:key="L14" ttm:agent="v1"><span begin="0:42.445" end="0:42.960">端</span><span begin="0:42.960" end="0:43.136">な</span><span begin="0:43.136" end="0:43.442">い</span><span begin="0:43.442" end="0:43.642">ほ</span><span begin="0:43.642" end="0:43.747">ど</span><span begin="0:43.747" end="0:44.129">集</span><span begin="0:44.129" end="0:44.593">中</span><span begin="0:44.593" end="0:45.001">力</span><span begin="0:45.001" end="0:45.097">が</span></p><p begin="0:45.417" end="0:48.781" itunes:key="L15" ttm:agent="v1"><span begin="0:45.417" end="0:45.484">着</span><span begin="0:45.484" end="0:45.807">い</span><span begin="0:45.807" end="0:46.214">た</span> <span begin="0:46.214" end="0:46.277">吐</span><span begin="0:46.277" end="0:46.637">い</span><span begin="0:46.637" end="0:47.036">た</span> <span begin="0:47.036" end="0:47.228">ツ</span><span begin="0:47.228" end="0:47.304">イ</span><span begin="0:47.304" end="0:47.352">ッ</span><span begin="0:47.352" end