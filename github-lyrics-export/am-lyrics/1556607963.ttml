<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">Rainych</ttm:name></ttm:agent><ttm:agent type="person" xml:id="v2"><ttm:name type="full">evening cinema</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>山下達郎</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">此刻穿越这湛蓝的地平线</text><text for="L2">感受着澄澈的时光的流逝</text><text for="L3">Ah</text><text for="L4">朝着期待的方向 开始运转的这个世界</text><text for="L5">曾经险些遗忘的梦想 也再度到访</text><text for="L6">Ride on time</text><text for="L7">将那些迷茫的思绪</text><text for="L8">也温柔地接纳 轻轻地包容</text><text for="L9">Ride on time</text><text for="L10">点燃心中的火焰</text><text for="L11">开阔心中的喜悦</text><text for="L12">Ride on time</text><text for="L13">我光辉的未来 开始运转</text><text for="L14">空虚的时光 全都溶于爱之中</text><text for="L15">Ah</text><text for="L16">美好的清晨 立刻会降临你的身边</text><text for="L17">前去将燃烧的心传递 坚定无惘</text><text for="L18">Ride on time</text><text for="L19">时间仍会不断向前流走</text><text for="L20">爱将散发出炫目的光芒</text><text for="L21">Ride on time</text><text for="L22">点燃心中的火焰</text><text for="L23">献给那展翅高飞的灵魂</text><text for="L24">Ride on time</text><text for="L25">前去将燃烧的心传递 就在此刻</text><text for="L26">Ride on time</text><text for="L27">时间仍会不断向前流走</text><text for="L28">爱将散发出炫目的光芒</text><text for="L29">Ride on time</text><text for="L30">点燃心中的火焰</text><text for="L31">献给那展翅高飞的灵魂</text><text for="L32">Ride on time</text><text for="L33">Ride on time</text><text for="L34">将那些迷茫的思绪</text><text for="L35">也温柔地接纳 轻轻地包容</text><text for="L36">Ride on time</text><text for="L37">点燃心中的火焰</text><text for="L38">开阔心中的喜悦</text><text for="L39">Ride on time</text><text for="L40">Ride on time</text><text for="L41">时间仍会不断向前流走</text><text for="L42">爱将散发出炫目的光芒</text><text for="L43">Ride on time</text><text for="L44">点燃心中的火焰</text><text for="L45">献给那展翅高飞的灵魂</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:01.505" end="0:10.681" itunes:key="L1" ttm:agent="v1"><span begin="0:01.505" end="0:02.263">青</span><span begin="0:02.263" end="0:03.031">い</span><span begin="0:03.960" end="0:04.847">水</span><span begin="0:04.847" end="0:05.303">平</span><span begin="0:05.303" end="0:06.239">線</span><span begin="0:06.239" end="0:07.550">を</span> <span begin="0:07.550" end="0:07.568">い</span><span begin="0:07.568" end="0:08.040">ま</span><span begin="0:08.040" end="0:08.528">駆</span><span begin="0:08.528" end="0:08.800">け</span><span begin="0:08.800" end="0:09.264">抜</span><span begin="0:09.264" end="0:09.536">け</span><span begin="0:09.536" end="0:10.274">て</span><span begin="0:10.274" end="0:10.681">く</span></p><p begin="0:11.522" end="0:21.616" itunes:key="L2" ttm:agent="v1"><span begin="0:11.522" end="0:11.736">と</span><span begin="0:11.736" end="0:12.104">ぎ</span><span begin="0:12.104" end="0:12.840">す</span><span begin="0:12.840" end="0:13.056">ま</span><span begin="0:13.056" end="0:13.552">さ</span><span begin="0:13.552" end="0:14.256">れ</span><span begin="0:14.256" end="0:15.224">た</span> <span begin="0:15.224" end="0:16.056">時</span><span begin="0:16.056" end="0:17.224">の</span><span begin="0:17.224" end="0:18.192">流</span><span begin="0:18.192" end="0:19.224">れ</span><span begin="0:19.224" end="0:20.088">感</span><span begin="0:20.088" end="0:21.265">じ</span><span begin="0:21.265" end="0:21.616">て</span></p><p begin="0:22.084" end="0:22.857" itunes:key="L3" ttm:agent="v1"><span begin="0:22.084" end="0:22.857">Ah</span></p><p begin="0:23.889" end="0:30.595" itunes:key="L4" ttm:agent="v1"><span begin="0:23.889" end="0:24.345">と</span><span begin="0:24.345" end="0:24.649">き</span><span begin="0:24.6