<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">ずっと真夜中でいいのに。 (永远是深夜有多好｡)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>ACAね</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">真是咸涩啊</text><text for="L2">第一次嗅闻舔舐到相遇的味道</text><text for="L3">自暴自弃 平均而正确的言论如此枯燥乏味</text><text for="L4">欢迎光临</text><text for="L5">添加大蒜 希望增强体质</text><text for="L6">以歌声充饥</text><text for="L7">优等生</text><text for="L8">佯装无知地起舞</text><text for="L9">这是缺点</text><text for="L10">于是为把握现状而中断</text><text for="L11">索性出让自我</text><text for="L12">向彼此炫耀心底的自卑</text><text for="L13">因为早已知晓</text><text for="L14">这是无法改变的吧？</text><text for="L15">依赖直觉自我中心</text><text for="L16">又难以理解的玩家</text><text for="L17">被这样的人追求真是桩惨案</text><text for="L18">生活因无聊的拌嘴不再那么难以忍受</text><text for="L19">还想听更多名言警句？</text><text for="L20">可是生活已经出乎意料的艰难了啊</text><text for="L21">即使</text><text for="L22">吵闹叫嚣过 被迎面痛击过</text><text for="L23">依然坚守日常不愿退让</text><text for="L24">把每一天化作营养 沾染彼此的污迹</text><text for="L25">剩余机会未知 发不出声响</text><text for="L26">脊髓反射泪腺破防</text><text for="L27">这浑浊的声音歌唱出来的 只有感谢</text><text for="L28">好想去尝试 如此温暖</text><text for="L29">穷途末路的夜晚 竟是如此舒适</text><text for="L30">平凡的生活 我也曾梦想过</text><text for="L31">先手必胜 感觉真是不错</text><text for="L32">回家后立刻给植物浇水 种种生活琐碎</text><text for="L33">即使实际早已无比幸运</text><text for="L34">虚无感仍旧如影随形</text><text for="L35">在耳边轻声低语消解困意</text><text for="L36">你一言我一语直到血液被饮尽</text><text for="L37">多么和睦友好的时光</text><text for="L38">依赖直觉自我中心</text><text for="L39">又难以理解的玩家</text><text for="L40">既然如此穷追不舍 便给你一场余兴小聚会</text><text for="L41">感谢细致入微的指点</text><text for="L42">尽管最终 还是会目瞪口呆</text><text for="L43">即使</text><text for="L44">吵闹叫嚣过 被迎面痛击过</text><text for="L45">依然坚守日常不愿退让</text><text for="L46">把每一天化作营养 沾染彼此的污迹？</text><text for="L47">剩余机会未知 发不出声响</text><text for="L48">脊髓反射泪腺破防</text><text for="L49">这浑浊的声音歌唱出来的 只有感谢</text><text for="L50">好想去尝试 如此温暖</text><text for="L51">穷途末路的夜晚 竟是如此舒适</text><text for="L52">平凡的生活 我也曾梦想过</text><text for="L53">先手必胜 感觉真是不错</text><text for="L54">我只想要安稳的生活</text><text for="L55">虽然</text><text for="L56">我不想给别人添麻烦</text><text for="L57">可如果不战斗 就不能被抚摸了</text><text for="L58">这道理很简单</text><text for="L59">即使</text><text for="L60">吵闹叫嚣过 被迎面痛击过</text><text for="L61">依然坚守日常不愿退让</text><text for="L62">把每一天化作营养 沾染彼此的污迹</text><text for="L63">剩余机会未知 发不出声响</text><text for="L64">脊髓反射泪腺破防</text><text for="L65">这浑浊的声音歌唱出来的 只有感谢</text><text for="L66">猜拳决定想说的话</text><text for="L67">每一次惠顾</text><text for="L68">都要储存起来 直到涌起实感</text><text for="L69">没能立刻倾诉出来 不够尽兴</text><text for="L70">脊髓反射泪腺破防</text><text for="L71">顶着萎缩的大脑歌唱 十分感谢</text><text for="L72">我本就没什么干劲坐不住又肤浅</text><text for="L73">只想为一些无聊的事情欢脱傻笑</text><text for="L74">但提供的伙食填不满我的不安</text><text for="L75">爆发很累人 但不会被看不起</text><text for="L76">为满身伤痕狂欢 喜悦至极 这很健康</text><text for="L77">感觉真不错</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:15.272" end="0:16.362" itunes:key="L1" ttm:agent="v1"><span begin="0:15.272" end="0:15.379">し</span><span begin="0:15.380" end="0:15.487">ょ</span><span begin="0:15.487" end="0:15.594">っ</span><span begin="0:15.595" end="0:15.794">ぱ</span><span begin="0:15.794" end="0:15.971">い</span><span begin="0:15.971" end="0:16.362">ぜ</span></p><p begin="0:16.362" end="0:18.584" itunes:key="L2" ttm:agent="v1"><span begin="0:16.362" end="0:16.729">初</span><span begin="0:16.729" end="0:16.910">め</span><span begin="0:16.910" end="0:17.036">て</span><span begin="0:17.036" end="0:17.098">嗅</span><span begin="0:17.098" end="0:17.217">い</span><span begin="0:17.217" end="0:17.484">で</span><span begin="0:17.484" end="0:17.651">舐</span><span begin="0:17.651" end="0:17.798">め</span><span begin="0:17.798" end="0:17.954">た</span><span begin="0:17.954" end="0:18.121">出</span><span begin="0:18.121" end="0:18.303">会</span><span begin="0:18.303" end="0:18.584">い</span></p><p begin="0:18.584" end="0:21.823" itunes:key="L3" ttm:agent="v1"><span begin="0:18.584" end="0:18.751">自</span><span begin="0:18.751" end="0:18.968">暴</span><span begin="0:18.968" end="0:19.123">自</span><span begin="0:19.123" end="0:19.470">棄</span><span begin="0:19.470" end="0:19.711">で</span><span begin="0:19.711" end="0:19.892">す</span> <span begin="0:19.892" end="0:20.058">平</span><span begin="0:20.058" end="0:20.264">均</span><span begin="0:20.264" end="0:20.608">的</span><span begin="0:20.608" end="0:20.774">な</span><span begin="0:20.774" end="0:20.899">正</span><span begin="0:20.899" end="0:21.076">論</span><span begin="0:21.076" end="0:21.288">が</span><span begin="0:21.288" end="0:21.495">貧</span><span begin="0:21.495" end="0:21.823">乏</span></p><p begin="0:21.823" end="0:23.224" itunes:key="L4" ttm:agent="v1"><span begin="0:21.823" end="0:21.963">い</span><span begin="0:21.963" end="0:22.140">ら</span><span begin="0:22.140" end="0:22.317">っ</span><span begin="0:22.317" end="0:22.422">し</span><span begin="0:22.422" end="0:22.527">ゃ</span><span begin="0:22.528" end="0:22.704">い</span><span begin="0:22.704" end="0:22.826">ま</span><span begin="0:22.826" end="0:23.224">せ</span></p><p begin="0:23.224" end="0:25.282" itunes:key="L5" ttm:agent="v1"><span begin="0:23.224" end="0:23.328">ニ</span><span begin="0:23.329" end="0:23.433">ン</span><span begin="0:23.433" end="0:23.558">ニ</span><span begin="0:23.558" end="0:23.670">ク</span><span begin="0:23.670" end="0:23.829">増</span><span begin="0:23.829" end="0:23.983">し</span><span begin="0:23.983" end="0:24.038">で</span><span begin="0:24.038" end="0:24.190">目</span><span begin="0:24.190" end="0:24.257">指</span><span begin="0:24.257" end="0:24.355">し</span><span begin="0:24.355" end="0:24.489">た</span><span begin="0:24.489" end="0:24.716">健</span><span begin="0:24.716" end="0:24.945">康</span><span begin="0:24.945" end="0:25.282">体</span></p><p begin="0:25.282" end="0:27.434" itunes:key="L6" ttm:agent="v1"><span begin="0:25.282" end="0:25.684">腹</span><span begin="0:25.684" end="0:26.113">歌</span><span begin="0:26.113" end="0:26.255">満</span><span begin="0:26.255" end="0:26.481">た</span><span begin="0:26.481" end="0:26.643">し</span><span begin="0:26.643" end="0:26.816">て</span><span begin="0:26.816" end="0:27.434">る</span></p><p begin="0:28.702" end="0:29.997" itunes:key="L7" ttm:agent="v1"><span begin="0:28.702" end="0:29.050">優</span><span begin="0:29.050" end="0:29.545">等</span><span begin="0:29.545" end="0:29.997">生</span></p><p begin="0:29.997" end="0:32.163" itunes:key="L8" ttm:agent="v1"><span begin="0:29.997" end="0:30.144">無</span><span begin="0:30.144" end="0:30.229">知</span><span begin="0:30.229" end="0:30.339">な</span><span begin="0:30.339" end="0:30.473">フ</span><span begin="0:30.473" end="0:30.606">リ</span><span begin="0:30.606" end="0:30.834">し</span><span begin="0:30.834" end="0:30.954">て</span><span begin="0:30.954" end="0:31.342">踊</span><span begin="0:31.342" end="0:31.457">っ</span><span begin="0:31.458" end="0:31.542">ち</span><span begin="0:31.542" end="0:31.626">ゃ</span><span begin="0:31.627" end="0:31.711">っ</span><span begin="0:31.711" end="0:32.163">て</span></p><p begin="0:32.163" end="0:33.490" itunes:key="L9" ttm:agent="v1"><span begin="0:32.163" end="0:32.569">欠</span><span begin="0:32.569" end="0:32.962">点</span><span begin="0:32.962" end="0:33.189">で</span><span begin="0:33.189" end="0:33.490">す</span></p><p begin="0:33.490" end="0:35.571" itunes:key="L10" ttm:agent="v1"><span begin="0:33.490" end="0:33.646">現</span><span begin="0:33.646" end="0:33.772">状</span><span begin="0:33.772" end="0:34.039">把</span><span begin="0:34.039" end="0:34.222">握</span><span begin="0:34.222" end="0:34.277">し</span><span begin="0:34.277" end="0:34.370">ち</span><span begin="0:34.370" end="0:34.463">ゃ</span><span begin="0:34.463" end="0:34.560">う</span><span begin="0:34.560" end="0:34.650">か</span><span begin="0:34.650" end="0:34.741">ら</span><span begin="0:34.741" end="0:34.942">中</span><span begin="0:34.942" end="0:35.163">断</span><span begin="0:35.163" end="0:35.571">中</span></p><p begin="0:35.571" end="0:36.855" itunes:key="L11" ttm:agent="v1"><span begin="0:35.571" end="0:35.772">も</span><span begin="0:35.772" end="0:35.973">う</span><span begin="0:35.974" end="0:36.420">譲</span><span begin="0:36.420" end="0:36.855">渡</span></p><p begin="0:36.855" end="0:39.017" itunes:key="L12" ttm:agent="v1"><span begin="0:36.855" end="0:37.020">見</span><span begin="0:37.020" end="0:37.237">せ</span><span begin="0:37.237" end="0:37.494">び</span><span begin="0:37.494" end="0:37.579">ら</span><span begin="0:37.579" end="0:37.675">か</span><span begin="0:37.675" end="0:37.767">し</span><span begin="0:37.767" end="0:37.848">合</span><span begin="0:37.848" end="0:37.974">い</span><span begin="0:37.974" end="0:38.155">ま</span><span begin="0:38.155" end="0:38.223">し</span><span begin="0:38.223" end="0:38.291">ょ</span><span begin="0:38.291" end="0:38.346">劣</span><span begin="0:38.346" end="0:38.508">等</span><span begin="0:38.508" end="0:38.855">感</span><span begin="0:38.855" end="0:39.017">妄</span></p><p begin="0:39.017" end="0:40.524" itunes:key="L13" ttm:agent="v1"><span begin="0:39.017" end="0:39.260">変</span><span begin="0:39.260" end="0:39.437">え</span><span begin="0:39.437" end="0:39.618">ら</span><span begin="0:39.618" end="0:39.653">れ</span><span begin="0:39.653" end="0:39.688">ゃ</span><span begin="0:39.688" end="0:39.764">し</span><span begin="0:39.764" end="0:39.921">な</span><span begin="0:39.921" end="0:40.095">い</span><span begin="0:40.095" end="0:40.269">っ</span><span begin="0:40.269" end="0:40.524">て</span></p><p begin="0:40.524" end="0:41.674" itunes:key="L14" ttm:agent="v1"><span begin="0:40.524" end="0:40.626">わ</span><span begin="0:40.626" end="0:40.746">か</span><span begin="0:40.747" end="0:40.867">っ</span><span begin="0:40.867" end="0:41.028">て</span><span begin="0:41.028" end="0:41.169">る</span><span begin="0:41.169" end="0:41.457">か</span><span begin="0:41.457" end="0:41.506">ら</span><span begin="0:41.506" end="0:41.555">ぁ</span><span begin="0:41.555" end="0:41.674">？</span></p></div><div itunes:song-part="PreChorus"><p begin="0:41.674" end="0:43.628" itunes:key="L15" ttm:agent="v1"><span begin="0:41.674" end="0:41.867">直</span><span begin="0:41.867" end="0:42.110">感</span><span begin="0:42.110" end="0:42.337">で</span><span begin="0:42.337" end="0:42.902">自</span><span begin="0:42.902" end="0:43.220">己</span><span begin="0:43.220" end="0:43.611">中</span><span begin="0:43.611" end="0:43.628">な</span></p><p begin="0:43.628" end="0:45.255" itunes:key="L16" ttm:agent="v1"><span begin="0:43.628" end="0:43.794">理</span><span begin="0:43.794" end="0:44.268">解</span><span begin="0:44.268" end="0:44.419">不</span><span begin="0:44.419" end="0:44.716">能</span><span begin="0:44.716" end="0:44.873">プ</span><span begin="0:44.873" end="0:44.958">レ</span><span begin="0:44.958" end="0:45.043">イ</span><span begin="0:45.044" end="0:45.238">ヤ</span><span begin="0:45.238" end="0:45.255">ー</span></p><p begin="0:45.383" end="0:48.798" itunes:key="L17" ttm:agent="v1"><span begin="0:45.383" end="0:46.196">求</span><span begin="0:46.196" end="0:46.433">め</span><span begin="0:46.433" end="0:46.666">ら</span><span begin="0:46.666" end="0:46.863">れ</span><span begin="0:46.863" end="0:47.030">た</span><span begin="0:47.030" end="0:47.232">な</span><span begin="0:47.232" end="0:47.449">ら</span><span begin="0:47.449" end="0:47.992">惨</span><span begin="0:47.992" end="0:48.239">事</span><span begin="0:48.239" end="0:48.798">会</span></p><p begin="0:48.976" end="0:52.387" itunes:key="L18" ttm:agent="v1"><span begin="0:48.976" end="0:49.150">く</span><span begin="0:49.150" end="0:49.370">だ</span><span begin="0:49.370