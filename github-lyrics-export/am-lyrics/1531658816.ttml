<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい (当山真玲)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>泣き虫</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">我是你最讨厌</text><text for="L2">最让你感觉麻烦的存在吧?</text><text for="L3">算了 没关系</text><text for="L4">如今怀着满心不甘地度过每一天</text><text for="L5">所谓最喜欢</text><text for="L6">是不存在不好不坏的安全牌的吧</text><text for="L7">算了 没关系 算了 没关系</text><text for="L8">算了 就这样吧 哈?</text><text for="L9">喜欢讨厌喜欢讨厌喜欢</text><text for="L10">讨厌喜欢讨厌喜欢讨厌喜欢</text><text for="L11">我讨厌这样揣测</text><text for="L12">再见面吧再见面吧再见面吧</text><text for="L13">再见面吧不断煽动</text><text for="L14">我讨厌这样做</text><text for="L15">虽然实现了 但因为我的错</text><text for="L16">虽然有多余 但也是属于我的</text><text for="L17">随意胡言乱语 die</text><text for="L18">虽然实现了 但因为我的错</text><text for="L19">虽然有多余 但也是属于我的</text><text for="L20">随意胡言乱语</text><text for="L21">我是你最讨厌</text><text for="L22">最让你感觉麻烦的存在吧?</text><text for="L23">算了 没关系</text><text for="L24">如今怀着满心不甘地度过每一天</text><text for="L25">所谓最喜欢</text><text for="L26">是不存在不好不坏的安全牌的吧</text><text for="L27">算了 没关系 算了 没关系</text><text for="L28">算了 就这样吧</text><text for="L29">你也不情愿吧?</text><text for="L30">不对 是怎么回事呢?</text><text for="L31">虽然努力挣扎过</text><text for="L32">最终却还是失去了吧?</text><text for="L33">对看不见的未来毫无期待</text><text for="L34">每天夜里都不知在做些什么</text><text for="L35">我并没有那么在意你</text><text for="L36">所谓的意义</text><text for="L37">也并没那么刻骨铭心</text><text for="L38">浣熊</text><text for="L39">也有偷懒的日子</text><text for="L40">懒懒酣睡 是吧?不信你看?</text><text for="L41">我是你最讨厌</text><text for="L42">最让你感觉麻烦的存在吧?</text><text for="L43">算了 没关系</text><text for="L44">如今怀着满心不甘地度过每一天</text><text for="L45">所谓最喜欢</text><text for="L46">是不存在不好不坏的安全牌的吧</text><text for="L47">算了 没关系 算了 没关系</text><text for="L48">算了 就这样吧</text><text for="L49">就是这样的吧?你感觉如何</text><text for="L50">这样那样的感情</text><text for="L51">你看见了吗?road show</text><text for="L52">看着录下来的电视节目</text><text for="L53">你作何想法?感觉如何</text><text for="L54">滴落快要枯竭的水面</text><text for="L55">来吧 轻轻将我拥抱</text><text for="L56">哈?</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:01.355" end="0:02.787" itunes:key="L1" ttm:agent="v1"><span begin="0:01.355" end="0:01.947">大</span><span begin="0:01.947" end="0:02.419">嫌</span><span begin="0:02.419" end="0:02.715">い</span><span begin="0:02.715" end="0:02.787">で</span></p><p begin="0:02.979" end="0:06.706" itunes:key="L2" ttm:agent="v1"><span begin="0:02.979" end="0:03.475">大</span><span begin="0:03.475" end="0:03.923">迷</span><span begin="0:03.923" end="0:04.418">惑</span><span begin="0:04.418" end="0:04.681">な</span><span begin="0:04.681" end="0:05.163">存</span><span begin="0:05.163" end="0:05.594">在</span><span begin="0:05.594" end="0:05.874">な</span><span begin="0:05.874" end="0:06.154">ん</span><span begin="0:06.154" end="0:06.554">で</span><span begin="0:06.554" end="0:06.602">し</span><span begin="0:06.602" end="0:06.650">ょ</span><span begin="0:06.650" end="0:06.683">う</span><span begin="0:06.683" end="0:06.706">?</span></p><p begin="0:07.357" end="0:08.485" itunes:key="L3" ttm:agent="v1"><span begin="0:07.357" end="0:07.405">ま</span><span begin="0:07.405" end="0:07.805">あ</span> <span begin="0:07.805" end="0:07.838">い</span><span begin="0:07.838" end="0:08.310">い</span><span begin="0:08.310" end="0:08.485">や</span></p><p begin="0:08.715" end="0:13.720" itunes:key="L4" ttm:agent="v1"><span begin="0:08.715" end="0:09.091">い</span><span begin="0:09.091" end="0:09.580">や</span><span begin="0:09.580" end="0:09.891">い</span><span begin="0:09.891" end="0:10.565">や</span><span begin="0:10.565" end="0:1