<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい (当山真玲)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Mirei Toyama</songwriter><songwriter>Samuel Morris Zornow</songwriter><songwriter>Zak Adams Leever</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">孤身在东京</text><text for="L2">无论身在何处，无论与谁相伴</text><text for="L3">都感到寂寞</text><text for="L4">在这东京倍感孤独</text><text for="L5">没有归宿，也没有去处</text><text for="L6">好累啊</text><text for="L7">隐隐作痛的脑袋</text><text for="L8">全怪那散落在桌上的</text><text for="L9">空易拉罐</text><text for="L10">只能继续麻醉自己</text><text for="L11">挤出吞下的药片</text><text for="L12">脑海中闪回着昨天的画面</text><text for="L13">总是搞砸同样的事情</text><text for="L14">滴滴滴（手机消息提示音）</text><text for="L15">“醒着吗？现在出来玩吧”</text><text for="L16">明明关系也没那么好吧？</text><text for="L17">反正闲着也是闲着，总比一个人好</text><text for="L18">什么都不用去想</text><text for="L19">我们在东京倍感孤独</text><text for="L20">无论身在何处，无论与谁相伴</text><text for="L21">都感到寂寞</text><text for="L22">孤身在东京</text><text for="L23">没有归宿，也没有去处</text><text for="L24">好累啊</text><text for="L25">社交动态设为“仅密友可见”</text><text for="L26">明明说今天很忙</text><text for="L27">应该没空见面的</text><text for="L28">是我男朋友，却总爱撒谎</text><text for="L29">也不遵守约定</text><text for="L30">但唯独那张脸我超级喜欢</text><text for="L31">叮咚咚（门铃声响起）</text><text for="L32">我会一直按铃直到你出来为止</text><text for="L33">一起回家吧</text><text for="L34">早就迷失了所谓的爱</text><text for="L35">也许打一开始就不懂</text><text for="L36">我们在东京倍感孤独</text><text for="L37">无论身在何处，无论与谁相伴</text><text for="L38">都感到寂寞</text><text for="L39">孤身在东京</text><text for="L40">没有归宿，也没有去处</text><text for="L41">好累啊</text><text for="L42">明明和这么多人保持着联系</text><text for="L43">明明手机的通知</text><text for="L44">一直响个不停</text><text for="L45">大家依然是孤身一人，不过是孤独者的群聚</text><text for="L46">如果想要遗忘这一切</text><text for="L47">什么都不记着也没关系</text><text for="L48">我们在东京倍感孤独</text><text for="L49">无论身在何处，无论与谁相伴</text><text for="L50">都感到寂寞</text><text for="L51">孤身在东京</text><text for="L52">没有归宿，也没有去处</text><text for="L53">好累啊</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Chorus"><p begin="0:02.797" end="0:04.754" itunes:key="L1" ttm:agent="v1"><span begin="0:02.797" end="0:03.633">Lonely</span> <span begin="0:03.633" end="0:03.893">in</span> <span begin="0:03.893" end="0:04.754">Tokyo</span></p><p begin="0:05.133" end="0:09.457" itunes:key="L2" ttm:agent="v1"><span begin="0:05.133" end="0:05.389">ど</span><span begin="0:05.389" end="0:05.835">こ</span><span begin="0:05.835" end="0:06.190">に</span><span begin="0:06.190" end="0:06.545">い</span><span begin="0:06.545" end="0:06.732">て</span><span begin="0:06.732" end="0:07.089">も</span> <span begin="0:07.429" end="0:08.249">誰</span><span begin="0:08.249" end="0:08.612">と</span><span begin="0:08.612" end="0:08.941">い</span><span begin="0:08.941" end="0:09.109">て</span><span begin="0:09.109" end="0:09.457">も</span></p><p begin="0:10.435" end="0:11.854" itunes:key="L3" ttm:agent="v1"><span begin="0:10.435" end="0:11.036">寂</span><span begin="0:11.036" end="0:11.215">し</span><span begin="0:11.216" end="0:11.395">い</span><span begin="0:11.395" end="0:11.854">の</span></p><p begin="0:12.058" end="0:13.955" itunes:key="L4" ttm:agent="v1"><span begin="0:12.058" end="0:12.887">Lonely</span> <span begin="0:12.887" end="0:13.167">in</span> <span begin="0:13.167" end="0:13.955">Tokyo</span></p><p begin="0:14.449" end="0:18.841" itunes:key="L5" ttm:agent="v1"><span begin="0:14.449" end="0:15.298">帰</span><span begin="0:15.298" end="0:15.662">る</span><span begin="0:15.662" end="0:15.921">場</span><span begin="0:15.921" end="0:16.073">所</span><span begin="0:16.073" end="0:16.456">も</span> <span begin="0:16.753" end="0:17.170">行</span><span begin="0:17.170" end="0:17.589">き</span><span begin="0:17.589" end="0:18.257">先</span><span begin="0:18.257" end="0:18.442">も</span><span begin="0:18.442" end="0:18.597">な</span><span begin="0:18.597" end="0:18.841">い</span></p><p begin="0:19.441" end="0:20.865" itunes:key="L6" ttm:agent="v1"><span begin="0:19.441" end="0:19.757">疲</span><span begin="0:19.757" end="0:20.028">れ</span><span begin="0:20.028" end="0:20.273">た</span><span begin="0:20.273" end="0:20.865">よ</span></p></div><div itunes:song-part="Verse"><p begin="0:21.020" end="0:25.835" itunes:key="L7" ttm:agent="v1"><span begin="0:21.020" end="0:21.446">痛</span><span begin="0:21.446" end="0:23.053">い</span><span begin="0:23.605" end="0:24.481">頭</span><span begin="0:24.481" end="0:24.974">は</span><span begin="0:24.974" end="0:25.598">全</span><span begin="0:25.598" end="0:25.835">部</span></p><p begin="0:26.008" end="0:28.154" itunes:key="L8" ttm:agent="v1"><span begin="0:26.008" end="0:26.217">テ</span><span begin="0:26.217" end="0:26.426">ー</span><span begin="0:26.426" end="0:26.601">ブ</span><span begin="0:26.601" end="0:26.739">ル</span><span begin="0:26.739" end="0:26.877">に</span><span begin="0:26.877" end="0:27.096">散</span><span begin="0:27.096" end="0:27.351">ら</span><span begin="0:27.351" end="0:27.578">ば</span><span begin="0:27.578" end="0:27.805">っ</span><span begin="0:27.805" end="0:28.154">た</span></p><p begin="0:28.505" end="0:30.376" itunes:key="L9" ttm:agent="v1"><span begin="0:28.505" end="0:28.882">空</span><span begin="0:28.882" end="0:29.071">き</span><span begin="0:29.071" end="0:29.449">缶</span><span begin="0:29.449" end="0:29.749">の</span><span begin="0:29.749" end="0:30.027">せ</span><span begin="0:30.027" end="0:30.376">い</span></p><p begin="0:30.376" end="0:32.327" itunes:key="L10" ttm:agent="v1"><span begin="0:30.376" end="0:30.616">Stay</span> <span begin="0:30.616" end="0:30.863">on</span> <span begin="0:30.863" end="