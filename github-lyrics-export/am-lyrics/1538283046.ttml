<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">當山みれい (当山真玲)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Mirei Toyama</songwriter><songwriter>Shingo.S</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">杂乱无章的房间里 两张沙发隔开距离</text><text for="L2">你蜷缩在其中一张里玩手机</text><text for="L3">电视里响起格外做作刺耳的笑声</text><text for="L4">我可不是专程为了看你才来的这里</text><text for="L5">上周日你人到底在哪里?</text><text for="L6">强忍泪水 声音颤抖</text><text for="L7">你理所当然地说了个陌生女孩的名字</text><text for="L8">为何能对我如此毫无避讳?</text><text for="L9">明明我那么相信你 你对我满口谎言</text><text for="L10">明明我深爱着你 我泪流不止</text><text for="L11">什么我无法放手 别离开我之类的话</text><text for="L12">事到如今怎么说得出口来 再见吧</text><text for="L13">我根本不知道为何</text><text for="L14">明明想要忘记 却还是忍不住找寻</text><text for="L15">那女孩的INS 厌恶起这样的自己</text><text for="L16">你们欢笑的模样幸福无比</text><text for="L17">让我想起当初我所喜欢的你</text><text for="L18">最近我们都已变得习以为常</text><text for="L19">对彼此越来越多的辜负与背叛</text><text for="L20">就算最开始的那种感觉</text><text for="L21">早就消失无踪</text><text for="L22">但喜欢的心情至今仍旧鲜明</text><text for="L23">明明我那么相信你 你对我满口谎言</text><text for="L24">明明我深爱着你 我泪流不止</text><text for="L25">什么我无法放手 别离开我之类的话</text><text for="L26">事到如今怎么说得出口来 再见吧</text><text for="L27">我根本不知道为何</text><text for="L28">对你的爱意满溢于心</text><text for="L29">从刚开始交往的LINE消息</text><text for="L30">到1周年 2周年纪念日 累积了很多回忆</text><text for="L31">原以为两人相处得越久</text><text for="L32">就可以变得足够爱</text><text for="L33">我究竟从何时起沦为了多余的存在</text><text for="L34">明明我那么相信你 你对我满口谎言</text><text for="L35">明明我深爱着你 我泪流不止</text><text for="L36">什么我无法放手 别离开我之类的话</text><text for="L37">事到如今怎么说得出口来 再见吧</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:10.013" end="0:14.223" itunes:key="L1" ttm:agent="v1"><span begin="0:10.013" end="0:10.173">ぐ</span><span begin="0:10.173" end="0:10.317">ち</span><span begin="0:10.317" end="0:10.461">ゃ</span><span begin="0:10.461" end="0:10.621">ぐ</span><span begin="0:10.621" end="0:10.775">ち</span><span begin="0:10.775" end="0:10.929">ゃ</span><span begin="0:10.929" end="0:11.261">の</span><span begin="0:11.261" end="0:11.566">部</span><span begin="0:11.566" end="0:12.318">屋</span> <span begin="0:12.318" end="0:12.766">別</span><span begin="0:12.766" end="0:13.197">々</span><span begin="0:13.197" end="0:13.568">の</span><span begin="0:13.568" end="0:13.838">ソ</span><span begin="0:13.838" end="0:13.917">フ</span><span begin="0:13.918" end="0:14.223">ァ</span></p><p begin="0:14.591" end="0:18.773" itunes:key="L2" ttm:agent="v1"><span begin="0:14.591" end="0:15.040">丸</span><span begin="0:15.040" end="0:15.247">ま</span><span begin="0:15.247" end="0:15.454">っ</span><span begin="0:15.455" end="0:15.887">て</span><span begin="0:15.887" end="0:16.473">携</span><span begin="0:16.473" end="0:16.841">帯</span><span begin="0:16.841" end="0:17.065">見</span><span begin="0:17.065" end="0:17.305">て</span><span begin="0:17.305" end="0:17.612">る</span><span begin="0:17.612" end="0:17.995">あ</span><span begin="0:17.995" end="0:18.393">な</span><span begin="0:18.393" end="0:18.773">た</span></p><p begin="0:19.090" end="0:23.342" itunes:key="L3" ttm:agent="v1"><span begin="0:19.090" end="0:19.250">わ</span><span begin="0:19.250" end="0:19.646">ざ</span><span begin="0:19.646" end="0:19.826">と</span><span begin="0:19.826" end="0:20.078">ら</span><span begin="0:20.078" end="0:20.222">し</span><span begin="0:20.222" end="0:20.494">く</span><span begin="0:20.494" end="0:20.830">笑</span><span begin="0:20.830" end="0:21.406">う</span> <span begin="0:21.406" end="0:21.566">テ</span><span begin="0:21.566" end="0:21.889">レ</span><span begin="0:21.889" end="0:22.046">ビ</span><span begin="0:22.046" end="0:22.366">が</span><span begin="0:22.366" end="0:22.958">響</span><span begin="0:22.958" end="0:23.342">く</span></p><p begin="0:23.710" end="0:27.582" itunes:key="L4" ttm:agent="v1"><span begin="0:23.710" end="0:23.873">た</span><span begin="0:23.873" end="0:24.142">だ</span><span begin="0:24.142" end="0:24.318">会</span><span begin="0:24.318" end="0:24.703">い</span><span begin="0:24.703" end="0:25.006">た</span><span begin="0:25.006" end="0:25.297">く</span><span begin="0:25.297" end="0:25.645">て</span><span begin="0:25.645" end="0:25.870">来</span><span begin="0:25.870" end="0:26.142">た</span><span begin="0:26.142" end="0:26.414">わ</span><span begin="0:26.414" end="0:26.720">け</span><span begin="0:26.720" end="0:26.895">じ</span><span begin="0:26.895" end="0:27.070">ゃ</span><span begin="0:27.070" end="0:27.439">な</span><span begin="0:27.439" end="0:27.582">い</span></p><p begin="0:27.855" end="0:31.883" itunes:key="L5" ttm:agent="v1"><span begin="0:27.855" end="0:28.271">先</span><span begin="0:28.271" end="0:28.766">週</span><span begin="0:28.766" end="0:29.358">日</span><span begin="0:29.358" end="0:29.678">曜</span> <span begin="0:29.839" end="0:30.126">ど</span><span begin="0:30.126" end="0:30.511">こ</span><span begin="0:30.511" end="0:30.870">に</span><span begin="0:30.870" end="0:31.229">い</span><span begin="0:31.230" end="0:31.694">た</span><span begin="0:31.693" end="0:31.883">?</span></p><p begin="0:32.445" end="0:36.303" itunes:key="L6" ttm:agent="v1"><span begin="0:32.445" end="0:33.261">涙</span><span begin="0:33.261" end="0:33.869">堪</span><span begin="0:33.869" end="0:34.029">え</span><span begin="0:34.029" end="0:34.398">て</span> <span begin="0:34.398" end="0:35.037">震</span><span begin="0:35.037" end="0:35.197">え</span><span begin="0:35.197" end="0:35.501">る</span><span begin="0:35.501" end="0:36.303">声</span></p><p begin="0:36.945" end="0:41.332" itunes:key="L7" ttm:agent="v1"><span begin="0:36.945" end="0:37.309">当</span><span begin="0:37.309" end="0:37.805">然</span><span begin="0:37.805" end="0:38.077">の</span><span begin="0:38.077" end="0:38.285">よ</span><span begin="0:38.285" end="0:38.493">う</span><span begin="0:38.493" end="0:38.959">に</span> <span begin="0:38.959" end="0:39.245">知</span><span begin="0:39.245" end="0:39.585">ら</span><span begin="0:39.585" end="0:39.773">な</span><span begin="0:39.773" end="0:40.124">い</span><span begin="0:40.124" end="0:40.396">子</span><span begin="0:40.396" end="0:40.652">の</span><span begin="0:40.652" end="0:40.933">名</span><span begin="0:40.933" end="0:41.332">前</span></p><p begin="0:41.606" end="0:45.897" itunes:key="L8" ttm:agent="v1"><span begin="0:41.606" end="0:41.789">ど</span><span begin="0:41.789" end="0:41.972">う</span><span begin="0:41.973" end="0:42.324">し</span><span begin="0:42.324" end="0:42.676">て</span><span begin="0:42.676" end="0:43.748">私</span><span begin="0:43.748" end="0:44.740">に</span> <span begin="0:44.740" end="0:44.980">言</span><span begin="0:44.980" end="0:45.229">え</span><span begin="0:45.229" end="0:45.536">る</span><span begin="0:45.536" end="0:45.741">の</span><span begin="0:45.740" end="0:45.897">?</span></p></div><div itunes:song-part="Chorus"><p begin="0:46.166" end="0:50.364" itunes:key="L9" ttm:agent="v1"><span begin="0:46.166" end="0:46.601">信</span><span begin="0:46.601" end="0:46.966">じ</span><span begin="0:46.966" end="0:47.272">て</span><span begin="0:47.272" end="0:47.734">た</span><span begin="0:47.734" end="0:48.133">の</span><span begin="0:48.133" end="0:49.288">に</span> <span begin="0:49.288" end="0:49.525">You</span> <span begin="0:49.525" end="0:49.855">lie</span> <span begin="0:49.855" end="0:50.115">you</span> <span begin="0:50.115" end="0:50.364">lie</span></p><p begin="0:50.667" end="0:55.016" itunes:key="L10" ttm:agent="v1"><span begin="0:50.667" end="0:51.117">愛</span><span begin="0:51.117" end="0:51.515">し</span><span begin="0:51.515" end="0:51.819">て</span><span begin="0:51.819" end="0:52.251">た</sp