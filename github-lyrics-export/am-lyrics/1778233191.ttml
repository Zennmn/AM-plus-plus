<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">YOASOBI (ヨアソビ)</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>Ayase</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">这是一如既往的今天 百无聊赖的时光</text><text for="L2">开始发生变化的</text><text for="L3">那一天的故事</text><text for="L4">接下来的我一定会</text><text for="L5">比至今为止的任何时刻</text><text for="L6">都更加自我 成为崭新的自己</text><text for="L7">越发得心应手的谄笑</text><text for="L8">总是和善亲切的模样</text><text for="L9">在日复一日中消磨着自身</text><text for="L10">真正的自己早已无处可寻</text><text for="L11">总是不以为然地说“我感觉很好”</text><text for="L12">口不对心地撒谎说“我能理解你的感受”</text><text for="L13">这一切已经让我不堪忍受</text><text for="L14">嘿 你有恋人吗？要不要来一场邂逅？</text><text for="L15">就此拉开新的序幕</text><text for="L16">糟糕的一天 烦心的事情</text><text for="L17">我的老板</text><text for="L18">别跟我说那些让我讨厌的话题</text><text for="L19">因为令人不快的多管闲事</text><text for="L20">而做出了无比郁闷的约定</text><text for="L21">这样的一天就此开始</text><text for="L22">约定见面地点是早晨的车站</text><text for="L23">我比平常稍作打扮</text><text for="L24">但其实也并无特别</text><text for="L25">内心忐忑慌乱的我</text><text for="L26">听见你呼唤我的名字抬起头来</text><text for="L27">我遇见了这个陌生人</text><text for="L28">我完全不知道你意味着什么</text><text for="L29">我遇见了这个陌生人</text><text for="L30">他有着长长的刘海</text><text for="L31">我遇见了这个陌生人</text><text for="L32">我遇见了他 他是那么神秘莫测</text><text for="L33">故事始于一场难以置信的相遇</text><text for="L34">从互道第一声初次见面起</text><text for="L35">转眼便到了此时此刻</text><text for="L36">逆风奔跑的我们</text><text for="L37">将平凡的时光抛在身后</text><text for="L38">穿过了一条又一条街巷</text><text for="L39">没错 我遇见了这个陌生人</text><text for="L40">我完全不知道你意味着什么</text><text for="L41">我遇见了这个陌生人</text><text for="L42">他穿着肥大的衬衫</text><text for="L43">我遇见了这个陌生人</text><text for="L44">我不知道自己该走哪条路</text><text for="L45">尽管是超乎想象的展开</text><text for="L46">但是 却满载着你赋予我的惊喜</text><text for="L47">匆匆忙忙的今天</text><text for="L48">让我幡然醒悟</text><text for="L49">其实一直以来</text><text for="L50">我真正讨厌的</text><text for="L51">一定就是我自己</text><text for="L52">启程飞向崭新的每一天</text><text for="L53">将以往的自己全部打破</text><text for="L54">无论会迎来怎样的明天</text><text for="L55">我都要活出自己 如此下定决心</text><text for="L56">没错 我遇见了这个陌生人</text><text for="L57">他打开了我所有的心门</text><text for="L58">未来我也还会遇见更多崭新的陌生人</text><text for="L59">要改变一成不变的今天 百无聊赖的时光</text><text for="L60">就趁今天吧</text><text for="L61">不要回望过去</text><text for="L62">属于我的故事 接下来才要揭开序幕</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Verse"><p begin="0:07.473" end="0:11.535" itunes:key="L1" ttm:agent="v1"><span begin="0:07.473" end="0:07.633">お</span><span begin="0:07.633" end="0:07.905">決</span><span begin="0:07.905" end="0:08.113">ま</span><span begin="0:08.113" end="0:08.457">り</span><span begin="0:08.457" end="0:08.745">の</span><span begin="0:08.745" end="0:09.193">今日</span><span begin="0:09.193" end="0:09.323">が</span> <span begin="0:09.547" end="0:09.774">退</span><span begin="0:09.774" end="0:10.270">屈</span><span begin="0:10.270" end="0:10.542">な</span><span begin="0:10.542" end="0:10.902">日</span><span begin="0:10.902" end="0:11.271">々</span><span begin="0:11.271" end="0:11.535">が</span></p><p begin="0:11.894" end="0:13.743" itunes:key="L2" ttm:agent="v1"><span begin="0:11.894" end="0:12.135">変</span><span begin="0:12.135" end="0:12.302">わ</span><span begin="0:12.302" end="0:12.535">り</span><span begin="0:12.535" end="0:13.103">始</span><span begin="0:13.103" end="0:13.486">め</span><span begin="0:13.486" end="0:13.743">た</span></p><p begin="0:13.943" end="0:16.528" itunes:key="L3" ttm:agent="v1"><span begin="0:13.943" end="0:14.247">あ</span><span begin="0:14.247" end="0:14.536">る</span><span begin="0:14.536" end="0:14.711">日</span><span begin="0:14.711" end="0:15.071">の</span><span begin="0:15.071" end="0:15.695">物</span><span begin="0:15.695" end="0:16.528">語</span></p><p begin="0:16.605" end="0:18.029" itunes:key="L4" ttm:agent="v1"><span begin="0:16.605" end="0:16.861">こ</span><span begin="0:16.861" end="0:17.037">こ</span><span begin="0:17.037" end="0:17.157">か</span><span begin="0:17.157" end="0:17.413">ら</span><span begin="0:17.413" end="0:17.605">き</span><span begin="0:17.605" end="0:17.797">っ</span><span begin="0:17.797" end="0:18.029">と</span></p><p begin="0:18.269" end="0:23.125" itunes:key="L5" ttm:agent="v1"><span begin="0:18.269" end="0:18.669">こ</span><span begin="0:18.669" end="0:18.845">れ</span><span begin="0:18.845" end="0:19.053">ま</span><span begin="0:19.053" end="0:19.429">で</span><span begin="0:19.429" end="0:19.653">の</span><span begin="0:19.653" end="0:19.861">ど</span><span begin="0:19.861" end="0:20.069">ん</span><span begin="0:20.069" end="0:20.277">な</span><span begin="0:20.277" end="0:21.141">私</span><span begin="0:21.141" end="0:21.333">よ</span><span begin="0:21.333" end="0:21.661">り</span><span begin="0:21.661" end="0:21.909">ず</span><span begin="0:21.909" end="0:22.157">っ</span><span begin="0:22.157" end="0:23.125">と</span></p><p begin="0:23.777" end="0:26.299" itunes:key="L6" ttm:agent="v1"><span begin="0:23.777" end="0:24.640">私</span><span begin="0:24.640" end="0:24.888">に</span><span begin="0:24.888" end="0:25.224">な</span><span begin="0:25.224" end="0:25.419">る</span> <span begin="0:25.642" end="0:25.899">new</span> <span begin="0:25.899" end="0:26.299">me</span></p><p begin="0:33.089" end="0:36.292" itunes:key="L7" ttm:agent="v1"><span begin="0:33.089" end="0:33.209">ど</span><span begin="0:33.210" end="0:33.330">ん</span><span begin="0:33.330" end="0:33.477">ど</span><span begin="0:33.478" end="0:33.625">ん</span><span begin="0:33.625" end="0:33.905">上</span><span begin="0:33.905" end="0:34.106">手</span><span begin="0:34.106" end="0:34.258">に</span><span begin="0:34.258" end="0:34.394">な</span><span begin="0:34.394" end="0:34.530">っ</span><span begin="0:34.530" end="0:34.630">て</span><span begin="0:34.630" end="0:34.730">い</span><span begin="0:34.730" end="0:34.881">く</span><span begin="0:34.881" end="0:36.292">smile</span></p><p begin="0:36.292" end="0:39.191" itunes:key="L8" ttm:agent="v1"><span begin="0:36.292" end="0:36.660">い</span><span begin="0:36.660" end="0:36.860">つ</span><span begin="0:36.860" end="0:37.100">も</span><span begin="0:37.100" end="0:38.508">愛</span><span begin="0:38.508" end="0:38.820">想</span><span begin="0:38.820" end="0:39.028">良</span><span begin="0:39.028" end="0:39.191">く</span></p><p begin="0:39.191" end="0:41.492" itunes:key="L9" ttm:agent="v1"><span begin="0:39.191" end="0:39.631">Day</span> <span begin="0:39.631" end="0:39.895">by</span> <span begin="0:39.895" end="0:40.271">day</span> <span begin="0:40.271" end="0:40.615">擦</span><span begin="0:40.615" end="0:40.799">り</span><span begin="0:40.799" end="0:40.975">減</span><span begin="0:40.975" end="0:41.231">ら</span><span begin="0:41.231" end="0:41.375">し</span><span begin="0:41.375" end="0:41.492">た</span></p><p begin="0:41.747" end="0:44.681" itunes:key="L10" ttm:agent="v1"><span begin="0:41.747" end="0:42.131">本</span><span begin="0:42.131" end="0:42.435">当</span><span begin="0:42.435" end="0:42.619">の</span><span begin="0:42.619" end="0:42.867">自</span><span begin="0:42.867" end="0:43.091">分</span><span begin="0:43.091" end="0:43.283">な</span><span begin="0:43.283" end="0:43.475">ん</span><span begin="0:43.475" end="0:43.659">て</span><span begin="0:43.659" end="0:43.795">居</span><span begin="0:43.795" end="0:44.352">な</span><span begin="0:44.352" end="0:44.681">い</span></p><p begin="0:44.681" end="0:46.921" itunes:key="L11" ttm:agent="v1"><span begin="0:44.681" end="0:45.273">嘯</span><span begin="0:45.273" end="0:45.544">い</span><span begin="0:45.544" end="0:45.660">た</span> <span begin="0:45.660" end="0:45.776">"</span><span begin="0:45.776" end="0:45.977">I'm</span> <span begin="0:45.977" end="0:46.480">feeling</span> <span begin="0:46.480" end="0:46.921">good"</span></p><p begin="0:46.921" end="0:48.943" itunes:key="L12" ttm:agent="v1"><span begin="0:46.921" end="0:47.257">嘘</span><span begin="0:47.257" end="0:47.416">付</span><span begin="0:47.416" end="0:47.656">き</span><span begin="0:47.656" end="0:47.760">な</span> <span begin="0:47.760" end="0:47.864">"</span><span begin="0:47.865" end="0:48.040">I'm</span> <span begin="0:48.040" end="0:48.609">feeling</span> <span begin="0:48.609" end="0:48.943">you"</span></p><p begin="0:48.943" end="0:50.453" itunes:key="L13" ttm:agent="v1"><span begin="0:48.943" end="0:49.087">た</span><span begin="0:49.087" end="0:49.247">ま</span><span begin="0:49.247" end="0:49.519">ら</span><span begin="0:49.519" end="0:49.791">な</span><span begin="0:49.791" end="0:50.119">い</span><span begin="0:50.119" end="0:50.453">わ</span></p></div><div itunes:song-part="PreChorus"><p begin="0:50.453" end="0:53.295" itunes:key="L14" ttm:agent="v1"><span begin="0:50.453" end="0:50.749">Hey</span> <span begin="0:50.749" end="0:51.077">you</span> <span begin="0:51.077" end="0:51.421">恋</span><span begin="0:51.421" end="0:51.797">人</span><span begin="0:51.797" end="0:52.085">は</span><span begin="0:52.085" end="0:52.094">？</span><span begin="0:52.094" end="0:52.374">出</span><span begin="0:52.374" end="0:52.518">会</span><span begin="0:52.518" end="0:52.670">い</span><span begin="0:52.670" end="0:52.815">と</span><span begin="0:52.815" end="0:52.942">か</span><span begin="0:52.942" end="0:53.054">は</span><span begin="0:53.054" end="0:53.134">ど</span><span begin="0:53.134" end="0:53.214">う</span><span begin="0:53.215" end="0:53.295">？</span></p><p begin="0:53.295" end="0:54.238" itunes:key="L15" ttm:agent="v1"><span begin="0:53.295" end="0:53.694">始</span><span begin="0:53.694" end="0:53.830">ま</span><span begin="0:53.830" end="0:53.966">っ</span><span begin="0:53.967" end="0:54.238">た</span></p></div><div itunes:song-part=