<?xml version='1.0' encoding='utf-8'?><tt xmlns="http://www.w3.org/ns/ttml" xmlns:ttm="http://www.w3.org/ns/ttml#metadata" xmlns:tts="http://www.w3.org/ns/ttml#styling" xmlns:amll="http://www.example.com/ns/amll" xmlns:itunes="http://music.apple.com/lyric-ttml-internal" itunes:timing="Word"><head><metadata><ttm:agent type="person" xml:id="v1"><ttm:name type="full">こっちのけんと</ttm:name></ttm:agent><iTunesMetadata xmlns="http://music.apple.com/lyric-ttml-internal"><songwriters><songwriter>こっちのけんと</songwriter><songwriter>GRP</songwriter></songwriters><translations><translation type="subtitle" xml:lang="zh-Hans"><text for="L1">“好的 乐意效劳”</text><text for="L2">“随时为您做好准备”</text><text for="L3">“好的 小的明白”</text><text for="L4">“一定谨遵您的吩咐”</text><text for="L5">遇事总是会伸出援手</text><text for="L6">让人以为是正义化身</text><text for="L7">不情不愿地生活至今</text><text for="L8">对顽固之人竖起盾牌</text><text for="L9">“好的 乐意效劳 随时为您做好准备”</text><text for="L10">“只要是我做得到的 一定竭尽全力”</text><text for="L11">试着迈出一步后</text><text for="L12">便想起了烦心事</text><text for="L13">奏响地狱的序曲吧</text><text for="L14">・・・</text><text for="L15">再试着迈出一步后</text><text for="L16">便想起了烦心事</text><text for="L17">让倾诉心声的3〜6音节响彻吧</text><text for="L18">・・・ーーー・・・</text><text for="L19">竭尽全力舞动起来 (舞动吧)</text><text for="L20">竭尽全力舞动起来 (再大声一些)</text><text for="L21">竭尽全力舞动起来 (舞动吧)</text><text for="L22">竭尽全力舞动起来 (再大声一些)</text><text for="L23">习惯那病态的城市迈步吧</text><text for="L24">隐藏自我 笑对他人的意见吧</text><text for="L25">将正义超人的包袱统统抛之脑后</text><text for="L26">让倾诉心声的3〜6音节响彻吧</text><text for="L27">・・・ーーー・・・</text><text for="L28">就算心怀愤怒</text><text for="L29">你的温柔软弱仍会胜出</text><text for="L30">我们的希望依旧缺席</text><text for="L31">得到拯救的是我心里的另一个我</text><text for="L32">试着迈出一步后</text><text for="L33">便想起了烦心事</text><text for="L34">奏响地狱的序曲吧</text><text for="L35">・・・</text><text for="L36">再试着迈出一步后</text><text for="L37">便想起了烦心事</text><text for="L38">让倾诉心声的3〜6音节响彻吧</text><text for="L39">在分岔路口随心所欲地闯一番吧</text><text for="L40">总说着交给我吧才是一种自私</text><text for="L41">来吧 奏响哈库那玛塔塔的音符吧</text><text for="L42">・・・ーーー・・・</text><text for="L43">竭尽全力舞动起来 (舞动吧)</text><text for="L44">竭尽全力舞动起来 (再大声一些)</text><text for="L45">竭尽全力舞动起来 (舞动吧)</text><text for="L46">竭尽全力舞动起来 (再大声一些)</text><text for="L47">习惯那病态的城市迈步吧</text><text for="L48">隐藏自我 笑对他人的意见吧</text><text for="L49">将正义超人的包袱统统抛之脑后</text><text for="L50">让倾诉心声的3〜6音节响彻吧</text><text for="L51">・・・ーーー・・・</text><text for="L52">“好的 乐意效劳 随时为您做好准备”</text><text for="L53">“只要是我做得到的 一定竭尽全力”</text><text for="L54">“好的 小的明白 一定谨遵您的吩咐”</text><text for="L55">让倾诉心声的3〜6音节响彻吧</text><text for="L56">・・・ーーー・・・</text></translation></translations></iTunesMetadata></metadata></head><body><div itunes:song-part="Intro"><p begin="0:07.905" end="0:09.878" itunes:key="L1" ttm:agent="v1"><span begin="0:08.081" end="0:08.217">は</span><span begin="0:08.217" end="0:08.473">い</span><span begin="0:08.473" end="0:09.145">喜</span><span begin="0:09.146" end="0:09.354">ん</span><span begin="0:09.354" end="0:09.849">で</span></p><p begin="0:11.117" end="0:13.081" itunes:key="L2" ttm:agent="v1"><span begin="0:11.285" end="0:11.445">あ</span><span begin="0:11.445" end="0:11.597">な</span><span begin="0:11.597" end="0:11.765">た</span><span begin="0:11.765" end="0:12.149">方</span><span begin="0:12.149" end="0:12.389">の</span><span begin="0:12.389" end="0:12.597">た</span><span begin="0:12.597" end="0:12.949">め</span></p><p begin="0:14.473" end="0:16.362" itunes:key="L3" ttm:agent="v1"><span begin="0:14.649" end="0:14.802">は</span><span begin="0:14.802" end="0:15.049">い</span><span begin="0:15.049" end="0:15.676">謹</span><span begin="0:15.676" end="0:15.880">ん</span><span begin="0:15.880" end="0:16.312">で</span></p><p begin="0:17.570" end="0:21.259" itunes:key="L4" ttm:agent="v1"><span begin="0:17.730" end="0:17.938">あ</span><span begin="0:17.938" end="0:18.122">な</span><span begin="0:18.122" end="0:18.282">た</span><span begin="0:18.282" end="0:18.666">方</span><span begin="0:18.666" end="0:18.882">の</span><span begin="0:18.882" end="0:19.106">た</span><span begin="0:19.106" end="0:19.588">め<